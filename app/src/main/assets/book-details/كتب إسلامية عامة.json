        "description": "\u064a\u062a\u0646\u0627\u0648\u0644 \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u062c\u0647\u0648\u062f \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0641\u064a \u062e\u062f\u0645\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0623\u0639\u0645\u0627\u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u063a\u0631\u0628. \u064a\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0624\u0644\u0641 \u0635\u0648\u0631\u064b\u0627 \u0645\u062a\u0639\u062f\u062f\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0645\u062b\u0644 \u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u0645\u0633\u0627\u062c\u062f \u0648\u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629\u060c \u0648\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0639\u0627\u0647\u062f \u0644\u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0645\u0646\u062d \u0627\u0644\u062f\u0631\u0627\u0633\u064a\u0629 \u0648\u0627\u0644\u0645\u0639\u0648\u0646\u0629 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u0634\u0639\u0628\u064a\u0629 \u0648\u0627\u0644\u062e\u0627\u0635\u0629. \u0643\u0645\u0627 \u064a\u0648\u0636\u062d \u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0623\u0633\u0633 \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u062a\u064a \u062a\u0642\u0648\u0645 \u0639\u0644\u064a\u0647\u0627 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0645\u0627\u062a\u060c \u0641\u064a \u0625\u0637\u0627\u0631 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u062d\u0636\u0627\u0631\u064a \u0648\u0627\u0644\u062a\u0639\u0627\u0631\u0641 \u0628\u064a\u0646 \u0627\u0644\u0634\u0639\u0648\u0628.",
        "topics": [
            "\u0627\u0644\u0645\u0642\u062f\u0645\u0629",
            "\u0645\u0646 \u0635\u0648\u0631 \u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u0625\u0633\u0644\u0627\u0645 \u0641\u064a \u0627\u0644\u063a\u0631\u0628",
            "\u0623\u0648\u0644\u0627 \u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u0645\u0633\u0627\u062c\u062f \u0648\u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629",
            "\u062b\u0627\u0646\u064a\u0627 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0639\u0627\u0647\u062f \u0644\u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u0639\u0631\u0628\u064a\u0629",
            "\u062b\u0627\u0644\u062b\u0627 \u0627\u0644\u0645\u0646\u062d \u0627\u0644\u062f\u0631\u0627\u0633\u064a\u0629",
            "\u0631\u0627\u0628\u0639\u0627 \u0627\u0644\u0645\u0639\u0648\u0646\u0629 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629",
            "\u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u062e\u0627\u0635\u0629 \u0648\u0627\u0644\u0634\u0639\u0628\u064a\u0629",
            "\u062c\u0647\u0648\u062f \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0641\u064a \u062e\u062f\u0645\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u063a\u0631\u0628"
