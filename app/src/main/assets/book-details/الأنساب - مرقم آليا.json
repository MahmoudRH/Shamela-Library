            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0641\u064a \u0639\u0645\u0627\u0646\u060c \u062d\u064a\u062b \u0642\u0627\u0645 \u0645\u0624\u0644\u0641\u0647 \u0633\u0627\u0644\u0645 \u0627\u0644\u0633\u064a\u0627\u0628\u064a \u0628\u062c\u0645\u0639 \u0645\u0627 \u0627\u0633\u062a\u0637\u0627\u0639 \u0645\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0648\u0644 \u0646\u0633\u0628 \u0642\u0628\u0627\u0626\u0644 \u0639\u0645\u0627\u0646\u064a\u0629 \u0645\u062e\u062a\u0644\u0641\u0629. \u064a\u0631\u0643\u0632 \u0627\u0644\u0643\u062a\u0627\u0628 \u0639\u0644\u0649 \u062a\u0646\u0627\u0648\u0644 \u0646\u0633\u0628 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0639\u0634\u0627\u0626\u0631 \u0648\u0627\u0644\u0623\u0633\u0631 \u0627\u0644\u0639\u0645\u0627\u0646\u064a\u0629\u060c \u0645\u0639\u062a\u0645\u062f\u0627\u064b \u0639\u0644\u0649 \u0637\u0631\u064a\u0642\u0629 \u063a\u064a\u0631 \u0645\u0646\u0638\u0645\u0629 \u0641\u064a \u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0648\u0627\u0644\u062a\u0642\u0633\u064a\u0645\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644\u0647 \u0645\u0631\u062c\u0639\u0627\u064b \u0645\u0641\u064a\u062f\u0627\u064b \u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0623\u0635\u0648\u0644 \u0623\u0647\u0644 \u0639\u0645\u0627\u0646 \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
        "title": "\u0627\u0644\u0623\u0646\u0633\u0627\u0628 = \u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628 = \u062a\u064e\u0627\u0631\u0650\u064a\u062e\u0650 \u0627\u0644\u0639\u064e\u0648\u0652\u062a\u064e\u0628\u0650\u064a",
        "authorDeathYear": 511,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0623\u0628\u0648 \u0627\u0644\u0645\u0646\u0630\u0631 \u0633\u0644\u0645\u0629 \u0628\u0646 \u0645\u0633\u0644\u0645 \u0628\u0646 \u0625\u0628\u0631\u0627\u0647\u064a\u0645 \u0627\u0644\u0635\u062d\u0627\u0631\u064a \u0627\u0644\u0639\u0648\u062a\u0628\u064a (\u0627\u0644\u0639\u064f\u0645\u064e\u0627\u0646\u064a \u0627\u0644\u0625\u0628\u0627\u0636\u064a) \u0646\u0633\u0628\u0629 \u0627\u0644\u0649 \u0639\u064e\u0648\u0652\u062a\u064e\u0628 \u0648\u0647\u064a \u0645\u0646\u0637\u0642\u0629 \u0641\u064a \u0635\u064f\u062d\u0627\u0631 \u0643\u0627\u0646\u062a \u062a\u0633\u0645\u0649 \u0641\u064a \u0627\u0644\u0642\u062f\u064a\u0645: \u0639\u0648\u062a\u0628 \u0627\u0644\u062e\u064a\u0627\u0645 (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 511\u0647\u0640)"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \"\u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628\" \u0644\u0645\u0624\u0644\u0641\u0647 \u0627\u0644\u0635\u062d\u0627\u0631\u064a\u060c \u064a\u062a\u0646\u0627\u0648\u0644 \u062a\u0627\u0631\u064a\u062e \u0646\u0633\u0628 \u0627\u0644\u0639\u0631\u0628 \u0645\u0646 \u0645\u0628\u062a\u062f\u0623 \u0627\u0644\u062e\u0644\u0642 \u062d\u062a\u0649 \u0642\u062d\u0637\u0627\u0646 \u0628\u0646 \u0647\u0648\u062f\u060c \u0645\u0631\u0648\u0631\u0627\u064b \u0628\u0642\u0635\u0629 \u0622\u062f\u0645 \u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0630\u0631\u064a\u062a\u0647\u060c \u0648\u0635\u0648\u0644\u0627\u064b \u0625\u0644\u0649 \u0646\u0648\u062d \u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0623\u0648\u0644\u0627\u062f\u0647. \u064a\u0630\u0643\u0631 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u0627\u064b \u0646\u0633\u0628 \u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628 \u0648\u0641\u0631\u0648\u0639\u0647\u0645\u060c \u0645\u0639 \u062a\u0642\u062f\u064a\u0645 \u0628\u0639\u0636 \u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0648\u0627\u0644\u0623\u0634\u0639\u0627\u0631 \u0627\u0644\u062a\u064a \u062a\u062a\u0639\u0644\u0642 \u0628\u0623\u062d\u062f\u0627\u062b \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0645\u0647\u0645\u0629\u060c \u0645\u062d\u0627\u0648\u0644\u0627\u064b \u0627\u0644\u0625\u064a\u062c\u0627\u0632 \u0648\u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0641\u064a \u0633\u0631\u062f\u0647 \u0644\u062a\u0643\u0648\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0623\u0648\u0636\u062d \u0648\u0623\u0633\u0647\u0644 \u0644\u0644\u0642\u0627\u0631\u0626.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
        "title": "\u0627\u0644\u0625\u0643\u0644\u064a\u0644",
        "authorDeathYear": 334,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0627\u0628\u0646 \u0627\u0644\u062d\u0627\u0626\u0643\u060c \u0623\u0628\u0648 \u0645\u062d\u0645\u062f \u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0623\u062d\u0645\u062f \u0628\u0646 \u064a\u0639\u0642\u0648\u0628 \u0628\u0646 \u064a\u0648\u0633\u0641 \u0628\u0646 \u062f\u0627\u0648\u062f \u0627\u0644\u0634\u0647\u064a\u0631 \u0628\u0627\u0644\u0647\u0645\u062f\u0627\u0646\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 334\u0647\u0640)"
            },
            {
