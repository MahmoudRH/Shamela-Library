            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0646\u0633\u0628 \u0642\u0631\u064a\u0634\u060c \u0645\u0631\u0643\u0651\u0632\u0627\u064b \u0639\u0644\u0649 \u062d\u0630\u0641 \u0628\u0639\u0636 \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0623\u0648 \u0627\u0644\u0623\u0633\u0631 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0646\u0633\u0628. \u064a\u0628\u062f\u0623 \u0627\u0644\u0645\u0624\u0644\u0641 \u0628\u0630\u0643\u0631 \u0646\u0633\u0628 \u0639\u0628\u062f \u0645\u0646\u0627\u0641 \u0628\u0646 \u0642\u0635\u064a \u0648\u0639\u0627\u0626\u0644\u0627\u062a\u0647\u060c \u062b\u0645 \u064a\u0646\u062a\u0642\u0644 \u0644\u0645\u0646\u0627\u0642\u0634\u0629 \u0623\u0641\u0631\u0627\u062f \u0622\u062e\u0631\u064a\u0646 \u0645\u0646 \u0642\u0631\u064a\u0634 \u0645\u062b\u0644 \u0623\u0628\u0646\u0627\u0621 \u0623\u0628\u064a \u0644\u0647\u0628 \u0648\u062d\u0644\u0641\u0627\u0621 \u0628\u0646\u064a \u0647\u0627\u0634\u0645. \u064a\u0634\u0645\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u0627\u064b \u0646\u0633\u0628\u0627\u064b \u0644\u0623\u0641\u0631\u0627\u062f \u0622\u062e\u0631\u064a\u0646 \u0645\u0646 \u0642\u0628\u0627\u0626\u0644 \u0642\u0631\u064a\u0634\u060c \u0645\u062b\u0644 \u0628\u0646\u064a \u0639\u0628\u062f \u0628\u0646 \u0642\u0635\u064a \u0648\u0628\u0646\u0648 \u0645\u062e\u0632\u0648\u0645. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u0635\u0648\u0631\u0629 \u0634\u0627\u0645\u0644\u0629 \u0639\u0646 \u0646\u0633\u0628 \u0642\u0631\u064a\u0634 \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0628\u0639\u0636 \u0627\u0644\u0634\u062e\u0635\u064a\u0627\u062a \u0648\u0627\u0644\u0633\u0644\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u062d\u062f\u062f\u0629.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
        "title": "\u0639\u062c\u0627\u0644\u0629 \u0627\u0644\u0645\u0628\u062a\u062f\u064a \u0648\u0641\u0636\u0627\u0644\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a \u0641\u064a \u0627\u0644\u0646\u0633\u0628",
        "authorDeathYear": 584,
