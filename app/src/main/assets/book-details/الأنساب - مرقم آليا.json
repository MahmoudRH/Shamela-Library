                "value": "\u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u0645\u0631 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0639\u0642\u064a\u0644 \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0628\u0623\u0628\u064a \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0628\u0646 \u0639\u0642\u064a\u0644 \u0627\u0644\u0638\u0627\u0647\u0631\u064a"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0646\u0633\u0628 \u0648\u0623\u062d\u062f\u0627\u062b \u0639\u0627\u0626\u0644\u0629 \u0622\u0644 \u0627\u0644\u062c\u0631\u0628\u0627\u0621\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u0631\u062d\u0644\u062a\u0647\u0645 \u0645\u0646 \u062c\u0646\u0648\u0628 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u0634\u0645\u0627\u0644\u060c \u0648\u0627\u0646\u062a\u0642\u0627\u0644\u0647\u0645 \u0625\u0644\u0649 \u0627\u0644\u0639\u0631\u0627\u0642\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0623\u0641\u0631\u0627\u062f \u0628\u0627\u0631\u0632\u064a\u0646 \u0645\u0646 \u0627\u0644\u0639\u0627\u0626\u0644\u0629 \u0648\u0641\u0631\u0648\u0639\u0647\u0627 \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629. \u064a\u0633\u062a\u0646\u062f \u0627\u0644\u0645\u0624\u0644\u0641 \u0641\u064a \u0628\u062d\u062b\u0647 \u0625\u0644\u0649 \u0627\u0644\u0631\u0648\u0627\u064a\u0629 \u0627\u0644\u0634\u0641\u0648\u064a\u0629 \u0648\u0627\u0644\u0634\u0639\u0631 \u0627\u0644\u0639\u0627\u0645\u064a \u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629\u060c \u0648\u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u0635\u0648\u0631\u0629 \u0634\u0627\u0645\u0644\u0629 \u0644\u062f\u0648\u0631 \u0622\u0644 \u0627\u0644\u062c\u0631\u0628\u0627\u0621 \u0641\u064a \u0628\u0646\u0627\u0621 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0639\u0631\u0627\u0642 \u0648\u0633\u0648\u0631\u064a\u0627\u060c \u0645\u0639 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0628\u0639\u0636 \u0627\u0644\u0633\u0644\u0628\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u0627\u0631\u062a\u0628\u0637\u062a \u0628\u0648\u062c\u0648\u062f\u0647\u0645 \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0645\u0646\u0627\u0637\u0642.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
        "title": "\u0625\u0633\u0639\u0627\u0641 \u0627\u0644\u0623\u0639\u064a\u0627\u0646 \u0641\u064a \u0623\u0646\u0633\u0627\u0628 \u0623\u0647\u0644 \u0639\u0645\u0627\u0646",
        "authorDeathYear": 1414,
