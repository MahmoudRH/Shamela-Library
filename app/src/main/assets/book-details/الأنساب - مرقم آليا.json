            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \"\u0639\u062c\u0627\u0644\u0629 \u0627\u0644\u0645\u0628\u062a\u062f\u064a \u0648\u0641\u0636\u0627\u0644\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a \u0641\u064a \u0627\u0644\u0646\u0633\u0628\" \u0644\u0644\u062d\u0627\u0632\u0645\u064a \u0647\u0648 \u062a\u0623\u0644\u064a\u0641 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u0623\u0646\u0633\u0627\u0628\u060c \u064a\u062a\u0646\u0627\u0648\u0644 \u0641\u064a\u0647 \u0627\u0644\u0645\u0624\u0644\u0641 \u062f\u0631\u0627\u0633\u0629 \u0648\u062a\u062a\u0628\u0639 \u0646\u0633\u0628 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0639\u062c\u0645\u064a\u0629. \u064a\u0642\u0633\u0645 \u0627\u0644\u0643\u062a\u0627\u0628 \u062d\u0633\u0628 \u0627\u0644\u062d\u0631\u0648\u0641 \u0627\u0644\u0647\u062c\u0627\u0626\u064a\u0629\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u0641\u064a \u0643\u0644 \u0628\u0627\u0628 \u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u062a\u064a \u062a\u0646\u0633\u0628 \u0625\u0644\u0649 \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0623\u0647\u0645\u064a\u0629 \u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u062d\u062f\u064a\u062b \u0648\u0628\u0646\u0627\u0621 \u062f\u0639\u0627\u0626\u0645 \u0627\u0644\u0625\u0633\u0644\u0627\u0645. \u064a\u0647\u062f\u0641 \u0627\u0644\u0643\u062a\u0627\u0628 \u0625\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u0645\u0642\u062f\u0645\u0629 \u0645\u0648\u062c\u0632\u0629 \u0644\u0643\u0644 \u0646\u0648\u0639 \u0645\u0646 \u0623\u0646\u0648\u0627\u0639 \u0639\u0644\u0645 \u0627\u0644\u062d\u062f\u064a\u062b\u060c \u0645\u0639 \u0625\u0628\u0631\u0627\u0632 \u0623\u0647\u0645\u064a\u0629 \u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0643\u0623\u062d\u062f \u0623\u0635\u0648\u0644 \u0647\u0630\u0627 \u0627\u0644\u0639\u0644\u0645.",
