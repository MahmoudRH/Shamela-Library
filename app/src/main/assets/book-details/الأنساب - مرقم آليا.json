                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u062c\u0645\u0647\u0631\u0629 \u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628 \u0644\u0627\u0628\u0646 \u0627\u0644\u0643\u0644\u0628\u064a \u0647\u064a \u062f\u0631\u0627\u0633\u0629 \u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u0644\u0623\u0635\u0648\u0644 \u0648\u062a\u0627\u0631\u064a\u062e \u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628\u060c \u0645\u0631\u0643\u0632\u0629 \u0639\u0644\u0649 \u0646\u0633\u0628\u0647\u0645 \u0648\u062a\u0641\u0631\u0639\u0627\u062a\u0647\u0645. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0628\u062f\u0621\u0627\u064b \u0645\u0646 \u0645\u0639\u062f \u0628\u0646 \u0639\u062f\u0646\u0627\u0646\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u062a\u0637\u0648\u0631\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u0623\u062c\u064a\u0627\u0644\u060c \u0645\u0639\u062a\u0645\u062f\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0648\u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0648\u0642\u062a. \u064a\u0634\u0645\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u0627\u064b \u0630\u0643\u0631 \u0623\u0641\u0631\u0627\u062f \u0628\u0627\u0631\u0632\u064a\u0646 \u0645\u0646 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0648\u0639\u0627\u0626\u0644\u0627\u062a\u0647\u0645\u060c \u0645\u0639 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0628\u0639\u0636 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0647\u0645.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
