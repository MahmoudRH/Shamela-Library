            }
        ],
        "description": "\u064a\u0642\u062f\u0645 \u0645\u062d\u0645\u062f \u0628\u0646 \u062d\u0645\u062f \u0627\u0644\u0628\u0633\u0627\u0645 \u0641\u064a \u0643\u062a\u0627\u0628\u0647 \"\u0627\u0644\u062f\u0631\u0631 \u0627\u0644\u0645\u0641\u0627\u062e\u0631 \u0641\u064a \u0623\u062e\u0628\u0627\u0631 \u0627\u0644\u0639\u0631\u0628 \u0627\u0644\u0623\u0648\u0627\u062e\u0631\" \u062f\u0631\u0627\u0633\u0629 \u0645\u0641\u0635\u0644\u0629 \u0644\u0623\u062d\u0648\u0627\u0644 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0641\u064a \u0645\u062e\u062a\u0644\u0641 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0645\u0631\u0643\u0632\u0627\u064b \u0639\u0644\u0649 \u0648\u0635\u0641 \u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u064a\u0645\u0646 \u0648\u062a\u0647\u0627\u0645\u0629 \u0648\u0627\u0644\u062d\u062c\u0627\u0632 \u0648\u0646\u062c\u062f \u0648\u0639\u0645\u0627\u0646 \u0648\u0627\u0644\u0639\u0631\u0627\u0642 \u0648\u062d\u0644\u0628. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0628\u0634\u0645\u0648\u0644\u064a\u0629 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0648\u062e\u0635\u0627\u0626\u0635\u0647\u0627 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0641\u0631\u0633\u0627\u0646\u0647\u0627 \u0648\u0623\u0628\u0637\u0627\u0644\u0647\u0627 \u0648\u0642\u0648\u0627\u062a\u0647\u0627 \u0627\u0644\u0642\u062a\u0627\u0644\u064a\u0629\u060c \u0645\u0642\u062f\u0645\u0627\u064b \u0635\u0648\u0631\u0629 \u0634\u0627\u0645\u0644\u0629 \u0639\u0646 \u0639\u0627\u062f\u0627\u062a \u0648\u062a\u0642\u0627\u0644\u064a\u062f \u0647\u0630\u0647 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0648\u0623\u0647\u0645\u064a\u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.",
