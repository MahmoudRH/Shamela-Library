            }
        ],
        "description": "\u0645\u0648\u0633\u0648\u0639\u0629 \u0639\u0634\u0627\u0626\u0631 \u0627\u0644\u0639\u0631\u0627\u0642 \u0643\u062a\u0627\u0628 \u0636\u062e\u0645 \u0645\u0646 \u0623\u0631\u0628\u0639\u0629 \u0645\u062c\u0644\u062f\u0627\u062a\u060c \u062a\u0645 \u062a\u0623\u0644\u064a\u0641\u0647 \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0623\u0648\u0644 \u0645\u0646 \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u0639\u0634\u0631\u064a\u0646 \u0627\u0644\u0645\u064a\u0644\u0627\u062f\u064a\u060c \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u0627\u0644\u0645\u0624\u0631\u0651\u062e \u0627\u0644\u0623\u062f\u064a\u0628 \u0627\u0644\u0645\u062d\u0627\u0645\u064a \u0639\u0628\u0627\u0633 \u0627\u0644\u0639\u0632\u0627\u0648\u064a \u0639\u0646 \u062a\u0627\u0631\u064a\u062e \u0648\u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0634\u0627\u0626\u0631 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0639\u0631\u0627\u0642\u064a\u0629 \u0627\u0644\u0628\u062f\u0648\u064a\u0651\u0629\u060c \u0648\u0627\u0644\u0631\u064a\u0641\u064a\u0651\u0629 (\u0627\u0644\u0634\u0627\u0648\u064a\u0651\u0629)\u060c \u0648\u0639\u0646 \u0627\u0644\u0639\u0634\u0627\u0626\u0631 \u0627\u0644\u0643\u0631\u062f\u064a\u0629. \u0648\u0627\u0645\u062a\u062f\u0627\u062f\u0647\u0627 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0641\u064a \u0633\u0648\u0631\u064a\u0627\u060c \u0648\u064a\u064f\u0639\u062f\u0651 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646 \u0623\u0642\u0648\u0649 \u0627\u0644\u0645\u0631\u0627\u062c\u0639 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0634\u0623\u0646.",
