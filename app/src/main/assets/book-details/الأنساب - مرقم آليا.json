            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0645\u0631\u0643\u0632\u0627\u064b \u0639\u0644\u0649 \u0646\u0633\u0628 \u0627\u0644\u0646\u0628\u064a \u0645\u062d\u0645\u062f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0648\u0639\u0627\u0626\u0644\u0627\u062a\u0647\u060c \u062b\u0645 \u064a\u0646\u062a\u0642\u0644 \u0644\u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0646\u0633\u0628 \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0645\u062b\u0644 \u0643\u0646\u0627\u0646\u0629\u060c \u0623\u0633\u062f\u060c \u0647\u0630\u064a\u0644\u060c \u0631\u0628\u064a\u0639\u0629\u060c \u0648\u062b\u0642\u064a\u0641. \u064a\u0647\u062f\u0641 \u0627\u0644\u0645\u0624\u0644\u0641 \u0625\u0644\u0649 \u062a\u0648\u0636\u064a\u062d \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0648\u0628\u064a\u0627\u0646 \u0623\u0635\u0648\u0644\u0647\u0627 \u0644\u0635\u0644\u0629 \u0627\u0644\u0631\u062d\u0645 \u0648\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0634\u0631\u0639\u064a\u0629 \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0647\u0627\u060c \u0645\u0633\u062a\u0639\u0631\u0636\u0627\u064b \u0623\u0642\u0648\u0627\u0644\u0627\u064b \u0644\u0644\u0646\u0628\u064a \u0648\u0623\u0635\u062d\u0627\u0628\u0647 \u062d\u0648\u0644 \u0623\u0647\u0645\u064a\u0629 \u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0623\u0646\u0633\u0627\u0628.",
