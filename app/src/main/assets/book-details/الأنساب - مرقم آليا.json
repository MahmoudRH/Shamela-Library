            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \"\u0627\u0644\u0625\u064a\u0646\u0627\u0633 \u0628\u0639\u0644\u0645 \u0627\u0644\u0623\u0646\u0633\u0627\u0628\" \u064a\u062a\u0646\u0627\u0648\u0644 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u0625\u064a\u0636\u0627\u062d \u0627\u0644\u062a\u0634\u0627\u0628\u0647\u0627\u062a \u0648\u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0648\u0627\u0644\u0623\u0644\u0642\u0627\u0628 \u0627\u0644\u0645\u0634\u0647\u0648\u0631\u0629 \u0641\u064a \u0627\u0644\u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628\u064a\u0629. \u064a\u0631\u0643\u0632 \u0627\u0644\u0645\u0624\u0644\u0641 \u0639\u0644\u0649 \u062a\u0648\u0636\u064a\u062d \u0627\u0644\u0641\u0631\u0648\u0642\u0627\u062a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u062a\u0634\u0627\u0628\u0647\u0629 \u0644\u062a\u0641\u0627\u062f\u064a \u0627\u0644\u0627\u0644\u062a\u0628\u0627\u0633\u060c \u0648\u064a\u0634\u0645\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u0633\u0645\u0627\u0621 \u0623\u0641\u0631\u0627\u062f \u0648\u0642\u0628\u0627\u0626\u0644 \u0645\u0646 \u0639\u062f\u0646\u0627\u0646 \u0648\u0642\u062d\u0637\u0627\u0646 \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u0633\u0644\u0627\u0644\u0627\u062a \u0627\u0644\u0639\u0631\u0628\u064a\u0629. \u0643\u0645\u0627 \u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0641\u064a \u0627\u0644\u0623\u062f\u0628 \u0639\u0644\u0649 \u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u0635\u062d\u064a\u0641 \u0641\u064a \u0627\u0644\u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0623\u0628\u064a\u0627\u062a \u0634\u0639\u0631\u064a\u0629 \u0648\u062a\u0639\u0642\u064a\u0628\u0627\u062a \u062a\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629. \u064a\u062a\u0645 \u062a\u0646\u0638\u064a\u0645 \u0627\u0644\u0643\u062a\u0627\u0628 \u062d\u0633\u0628 \u062d\u0631\u0648\u0641 \u0627\u0644\u0645\u0639\u062c\u0645\u060c \u0645\u0645\u0627 \u064a\u0633\u0647\u0644 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
