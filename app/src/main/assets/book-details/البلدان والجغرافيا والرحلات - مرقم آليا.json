            }
        ],
        "description": "\u064a\u0639\u062f \u0643\u062a\u0627\u0628 \"\u0627\u0644\u062f\u064a\u0627\u0631\u0627\u062a\" \u0645\u0646 \u062a\u0623\u0644\u064a\u0641 \u0623\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u0627\u0644\u0623\u0635\u0628\u0647\u0627\u0646\u064a\u060c \u0648\u0647\u0648 \u064a\u062a\u0636\u0645\u0646 \u0623\u062e\u0628\u0627\u0631\u0627\u064b \u0648\u062a\u0631\u0627\u062c\u0645 \u0639\u0646 \u062f\u064a\u0631\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629 \u062a\u0642\u0639 \u0641\u064a \u0623\u0631\u062c\u0627\u0621 \u0645\u062e\u062a\u0644\u0641\u0629 \u0645\u0646 \u0628\u0644\u0627\u062f \u0627\u0644\u0634\u0627\u0645 \u0648\u0627\u0644\u0639\u0631\u0627\u0642. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u062a\u0627\u0631\u064a\u062e \u0647\u0630\u0647 \u0627\u0644\u062f\u064a\u0631\u0627\u062a \u0648\u0623\u0647\u0645 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0648\u0627\u0644\u0642\u0635\u0635 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0647\u0627\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u062f\u064a\u0631 \u0623\u0628\u0644\u0642 \u0648\u062f\u064a\u0631 \u0627\u0644\u0623\u0639\u0644\u0649 \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u062f\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0634\u0647\u0648\u0631\u0629. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u0627\u064b \u0648\u0635\u0641\u0627\u064b \u0644\u0644\u062f\u064a\u0631\u0627\u062a \u0648\u0645\u0648\u0642\u0639\u0647\u0627 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a \u0648\u0642\u0635\u0635\u0627\u064b \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0647\u0627\u060c \u0645\u0639 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0628\u0639\u0636 \u0627\u0644\u0634\u062e\u0635\u064a\u0627\u062a \u0627\u0644\u0628\u0627\u0631\u0632\u0629 \u0627\u0644\u062a\u064a \u0639\u0627\u0634\u062a \u0623\u0648 \u0632\u0627\u0631\u062a \u0647\u0630\u0647 \u0627\u0644\u062f\u064a\u0631\u0627\u062a.",
