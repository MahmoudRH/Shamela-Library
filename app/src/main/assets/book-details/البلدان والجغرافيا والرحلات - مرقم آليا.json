    {
        "title": "\u0627\u0644\u062e\u0632\u0644 \u0648\u0627\u0644\u062f\u0623\u0644 \u0628\u064a\u0646 \u0627\u0644\u062f\u0648\u0631 \u0648\u0627\u0644\u062f\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u062f\u064a\u0631\u0629",
