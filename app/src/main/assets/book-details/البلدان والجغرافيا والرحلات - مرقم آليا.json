            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u062c\u0645\u0627\u0644 \u0627\u0644\u062f\u064a\u0646 \u0623\u0628\u0648 \u0627\u0644\u0641\u062a\u062d \u064a\u0648\u0633\u0641 \u0628\u0646 \u064a\u0639\u0642\u0648\u0628 \u0627\u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0628\u0627\u0628\u0646 \u0627\u0644\u0645\u062c\u0627\u0648\u0631 \u0627\u0644\u0634\u064a\u0628\u0627\u0646\u064a \u0627\u0644\u062f\u0645\u0634\u0642\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 690\u0647\u0640)"
