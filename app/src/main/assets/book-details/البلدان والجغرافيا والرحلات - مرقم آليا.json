            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0641\u0636\u0627\u0626\u0644 \u0645\u0635\u0631 \u0648\u062e\u0635\u0627\u0626\u0635\u0647\u0627 \u0627\u0644\u0645\u0645\u064a\u0632\u0629\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0633\u0627\u0626\u0631 \u0627\u0644\u0628\u0644\u062f\u0627\u0646\u060c \u0645\u0633\u062a\u0639\u0631\u0636\u0627\u064b \u0622\u062b\u0627\u0631\u0647\u0627 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0648\u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0648\u0627\u0644\u062f\u064a\u0646\u064a\u0629. \u064a\u0630\u0643\u0631 \u0627\u0644\u0645\u0624\u0644\u0641 \u0623\u0628\u0648 \u0639\u0645\u0631 \u0627\u0644\u0643\u0646\u062f\u064a \u0641\u0636\u0644 \u0645\u0635\u0631 \u0641\u064a \u0627\u0644\u062f\u064a\u0646 \u0648\u0627\u0644\u062f\u0646\u064a\u0627\u060c \u0648\u064a\u0633\u062a\u0634\u0647\u062f \u0628\u0622\u064a\u0627\u062a \u0642\u0631\u0622\u0646\u064a\u0629 \u0648\u0623\u062d\u0627\u062f\u064a\u062b \u0646\u0628\u0648\u064a\u0629 \u062a\u062f\u0644 \u0639\u0644\u0649 \u0645\u0643\u0627\u0646\u0629 \u0645\u0635\u0631 \u0627\u0644\u0639\u0638\u064a\u0645\u0629. \u0643\u0645\u0627 \u064a\u0633\u0631\u062f \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0648\u0627\u0644\u062d\u0643\u0645\u0627\u0621 \u0648\u0627\u0644\u0641\u0642\u0647\u0627\u0621 \u0648\u0627\u0644\u0632\u0647\u0627\u062f \u0627\u0644\u0630\u064a\u0646 \u0639\u0627\u0634\u0648\u0627 \u0641\u064a\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u0639\u0635\u0648\u0631\u060c \u0645\u0628\u064a\u0646\u0627\u064b \u0645\u0627 \u062c\u0639\u0644 \u0645\u0646\u0647\u0627 \u0628\u0644\u062f\u0627\u064b \u0645\u0641\u0636\u0644\u0627\u064b \u0641\u064a \u0646\u0638\u0631 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647.",
