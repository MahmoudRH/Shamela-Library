            }
        ],
        "description": "\u064a\u0642\u062f\u0645 \u0627\u0628\u0646 \u0633\u0639\u064a\u062f \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0641\u064a \u0643\u062a\u0627\u0628\u0647 \"\u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0627\" \u0648\u0635\u0641\u0627\u064b \u0645\u0641\u0635\u0644\u0627\u064b \u0644\u0644\u0639\u0627\u0644\u0645 \u0645\u0646 \u0645\u0646\u0638\u0648\u0631 \u062c\u063a\u0631\u0627\u0641\u064a \u0648\u0631\u062d\u0644\u0627\u062a\u064a\u060c \u062d\u064a\u062b \u064a\u0642\u0633\u0645 \u0627\u0644\u0645\u0639\u0645\u0648\u0631 \u0625\u0644\u0649 \u062a\u0633\u0639\u0629 \u0623\u0642\u0633\u0627\u0645 \u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0645\u0646\u0647\u0627 \u0645\u0627 \u0647\u0648 \u062e\u0644\u0641 \u062e\u0637 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u0621 \u0625\u0644\u0649 \u0627\u0644\u062c\u0646\u0648\u0628\u060c \u0648\u0627\u0644\u0625\u0642\u0644\u064a\u0645 \u0627\u0644\u0623\u0648\u0644 \u0648\u062d\u062a\u0649 \u0627\u0644\u0633\u0627\u0628\u0639\u060c \u0645\u0639 \u062a\u0641\u0635\u064a\u0644 \u0644\u0644\u062c\u0632\u0621 \u0627\u0644\u0623\u0648\u0644 \u0645\u0646 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0634\u0645\u0644 \u0645\u062f\u0646\u064b\u0627 \u0633\u0648\u062f\u0627\u0646\u064a\u0629 \u0648\u0635\u062d\u0627\u0631\u064a \u0648\u064a\u0646\u0627\u0628\u064a\u0639 \u0646\u0647\u0631 \u0627\u0644\u0646\u064a\u0644. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0648\u0635\u0641 \u0627\u0644\u0623\u0631\u0636 \u0643\u0643\u0631\u0629 \u0645\u062d\u0627\u0637\u0629 \u0628\u0627\u0644\u0645\u0627\u0621\u060c \u0648\u064a\u0642\u0633\u0645 \u0627\u0644\u0645\u0639\u0645\u0648\u0631 \u0625\u0644\u0649 \u0623\u0642\u0633\u0627\u0645 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0639\u0631\u0636 \u0648\u0627\u0644\u0637\u0648\u0644\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0627 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0648\u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0645\u0646\u0627\u0637\u0642.",
