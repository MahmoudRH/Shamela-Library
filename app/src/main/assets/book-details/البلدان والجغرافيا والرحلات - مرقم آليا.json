            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0633\u062a\u0628\u0635\u0631 \u0647\u0648 \u0643\u062a\u0627\u0628 \u062c\u063a\u0631\u0627\u0641\u064a \u0623\u0644\u0641\u0647 \u0627\u0644\u0645\u0624\u0631\u062e \u0627\u0628\u0646 \u0627\u0644\u0645\u062c\u0627\u0648\u0631 (601 \u0647\u0640 - 690 \u0647\u0640)\u060c \u062a\u062d\u062f\u062b \u0627\u0644\u0645\u0624\u0644\u0641 \u0641\u064a \u0643\u062a\u0627\u0628\u0647 \u0639\u0646 \u0648\u0635\u0641 \u0628\u0644\u0627\u062f \u0627\u0644\u064a\u0645\u0646 \u0648\u0645\u0643\u0629 \u0648\u0627\u0644\u062d\u062c\u0627\u0632 \u060c \u0648\u0627\u0628\u062a\u062f\u0623 \u0628\u0627\u0644\u0643\u0644\u0627\u0645 \u0639\u0646 \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u062b\u0645 \u0627\u0646\u062a\u0647\u0649 \u0628\u0627\u0644\u0628\u062d\u0631\u064a\u0646 , \u0627\u0637\u0644\u0639 \u0641\u064a\u0647 \u0639\u0644\u0649 \u0627\u0644\u0623\u062f\u0644\u0629 \u0627\u0644\u0645\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0634\u0647\u0648\u0631\u0629 \u060c \u0648\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0639\u0644\u0648\u0645 \u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0627\u0644\u062a\u064a \u062a\u0635\u0641 \u062e\u0637\u0648\u0637 \u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0648\u0623\u0637\u0648\u0627\u0644\u0647\u0627 \u0628\u064a\u0646 \u0628\u0644\u0627\u062f \u0627\u0644\u0639\u0631\u0628 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 \u0648\u062c\u0632\u064a\u0631\u0629 \u062c\u0627\u0648\u0629 , \u062e\u0635\u0635 \u062c\u0632\u0621 \u0645\u0646 \u0643\u062a\u0627\u0628\u0647 \u0644\u0648\u0635\u0641 \u0645\u062f\u064a\u0646\u062a\u064a \u0639\u062f\u0646 \u0648\u062c\u062f\u0629. \u064a\u064f\u0639\u062a\u0642\u062f \u0623\u0646 \u0627\u0628\u0646 \u0627\u0644\u0645\u062c\u0627\u0648\u0631 \u0623\u0644\u0641 \u0643\u062a\u0627\u0628\u0647 \u0627\u0644\u0645\u0633\u062a\u0628\u0635\u0631 \u0642\u0628\u0644 \u0639\u0627\u0645 1233 \u0645.",
