    {
        "title": "\u062d\u0627\u062f\u064a \u0627\u0644\u0623\u0638\u0639\u0627\u0646 \u0627\u0644\u0646\u062c\u062f\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u062f\u064a\u0627\u0631 \u0627\u0644\u0645\u0635\u0631\u064a\u0629",
