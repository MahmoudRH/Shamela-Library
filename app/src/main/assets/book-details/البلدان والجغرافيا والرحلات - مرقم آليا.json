[
    {
        "title": "\u0627\u0644\u0623\u0639\u0644\u0627\u0642 \u0627\u0644\u062e\u0637\u064a\u0631\u0629 \u0641\u064a \u0630\u0643\u0631 \u0623\u0645\u0631\u0627\u0621 \u0627\u0644\u0634\u0627\u0645 \u0648 \u0627\u0644\u062c\u0632\u064a\u0631\u0629",
        "authorDeathYear": 684,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0627\u0628\u0646 \u0634\u062f\u0627\u062f\u060c \u0639\u0632 \u0627\u0644\u062f\u064a\u0646 \u0623\u0628\u0648 \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u0644\u064a \u0628\u0646 \u0625\u0628\u0631\u0627\u0647\u064a\u0645 \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064a \u0627\u0644\u062d\u0644\u0628\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 684\u0647\u0640)"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \"\u0627\u0644\u0623\u0639\u0644\u0627\u0642 \u0627\u0644\u062e\u0637\u064a\u0631\u0629 \u0641\u064a \u0630\u0643\u0631 \u0623\u0645\u0631\u0627\u0621 \u0627\u0644\u0634\u0627\u0645 \u0648\u0627\u0644\u062c\u0632\u064a\u0631\u0629\" \u0644\u0644\u0639\u0644\u0627\u0645\u0629 \u0639\u0632 \u0627\u0644\u062f\u064a\u0646 \u0627\u0628\u0646 \u0634\u062f\u0627\u062f\u060c \u064a\u062a\u0646\u0627\u0648\u0644 \u0648\u0635\u0641\u064b\u0627 \u062a\u0627\u0631\u064a\u062e\u064a\u064b\u0627 \u0648\u062b\u0642\u0627\u0641\u064a\u064b\u0627 \u0644\u0645\u062f\u064a\u0646\u0629 \u062d\u0644\u0628 \u0648\u0627\u0644\u0634\u0627\u0645 \u0648\u0627\u0644\u062c\u0632\u064a\u0631\u0629. \u064a\u0631\u0643\u0632 \u0627\u0644\u0645\u0624\u0644\u0641 \u0639\u0644\u0649 \u0630\u0643\u0631 \u0627\u0644\u0623\u0645\u0631\u0627\u0621 \u0648\u0627\u0644\u062d\u0643\u0627\u0645 \u0627\u0644\u0630\u064a\u0646 \u062d\u0643\u0645\u0648\u0627 \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u0645\u0639 \u062a\u0642\u062f\u064a\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0648\u062c\u063a\u0631\u0627\u0641\u064a\u0629 \u0639\u0646 \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0644\u0642\u0644\u0627\u0639 \u0648\u0627\u0644\u0645\u0633\u0627\u062c\u062f \u0648\u0627\u0644\u0645\u0639\u0627\u0644\u0645 \u0627\u0644\u0623\u062b\u0631\u064a\u0629. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u064b\u0627 \u0641\u0636\u0644 \u0627\u0644\u0634\u0627\u0645 \u0648\u0645\u0627 \u0648\u0631\u062f \u0641\u064a \u0641\u0636\u0627\u0626\u0644\u0647\u0627 \u0645\u0646 \u0623\u062d\u0627\u062f\u064a\u062b \u0648\u0642\u0635\u0635\u060c \u0645\u0639 \u0648\u0635\u0641 \u0645\u0641\u0635\u0644 \u0644\u0639\u0645\u0627\u0631\u062a\u0647\u0627 \u0648\u0623\u0628\u0646\u064a\u062a\u0647\u0627 \u0648\u062d\u062f\u0648\u062f\u0647\u0627 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0629.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
