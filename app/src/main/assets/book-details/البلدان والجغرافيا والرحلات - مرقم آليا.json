        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0631\u062d\u0644\u0629 \u0645\u0624\u0644\u0641\u0647 \u0625\u0644\u0649 \u0645\u0635\u0631\u060c \u062d\u064a\u062b \u064a\u0630\u0643\u0631 \u062a\u0641\u0627\u0635\u064a\u0644 \u0631\u0641\u0642\u062a\u0647 \u0645\u0639 \u0642\u0627\u0636\u064a \u0627\u0644\u0642\u0636\u0627\u0629 \u062c\u0648\u064a \u0632\u0627\u062f\u0647 \u0641\u064a \u0631\u062d\u0644\u062a\u0647\u0645\u0627 \u0645\u0646 \u062f\u0645\u0634\u0642 \u0625\u0644\u0649 \u0627\u0644\u0642\u0627\u0647\u0631\u0629. \u064a\u0631\u0643\u0632 \u0627\u0644\u0646\u0635 \u0639\u0644\u0649 \u0648\u0635\u0641 \u0627\u0644\u0645\u063a\u0627\u0645\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u062a\u064a \u0645\u0631 \u0628\u0647\u0627 \u0627\u0644\u0645\u0624\u0644\u0641 \u062e\u0644\u0627\u0644 \u0631\u062d\u0644\u062a\u0647\u060c \u0643\u0645\u0627 \u064a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0642\u0644\u0639\u0629 \u0641\u064a \u0627\u0644\u0642\u062f\u0633 \u0648\u0627\u0644\u062a\u0641\u062a\u064a\u0634 \u0639\u0644\u0649 \u0627\u0644\u0643\u0646\u064a\u0633\u0629 \u0647\u0646\u0627\u0643 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0623\u0648\u0627\u0645\u0631 \u062d\u0643\u0648\u0645\u064a\u0629. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u0646\u062f\u0631\u062c \u0636\u0645\u0646 \u0641\u0626\u0629 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0648\u0635\u0641\u064a\u0629\u060c \u0648\u064a\u0642\u062f\u0645 \u0644\u0645\u062d\u0629 \u0639\u0646 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u062e\u0644\u0627\u0644 \u0641\u062a\u0631\u0629 \u0643\u062a\u0627\u0628\u0629