                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0639\u0644\u064a \u0628\u0646 \u0627\u0644\u062d\u0633\u064a\u0646 \u0628\u0646 \u0645\u062d\u0645\u062f \u0628\u0646 \u0623\u062d\u0645\u062f \u0628\u0646 \u0627\u0644\u0647\u064a\u062b\u0645 \u0627\u0644\u0645\u0631\u0648\u0627\u0646\u064a \u0627\u0644\u0623\u0645\u0648\u064a \u0627\u0644\u0642\u0631\u0634\u064a\u060c \u0623\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0627\u0644\u0623\u0635\u0628\u0647\u0627\u0646\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 356\u0647\u0640)"
            },
