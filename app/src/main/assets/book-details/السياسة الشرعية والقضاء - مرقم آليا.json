            {
                "label": "\u0627\u0644\u0646\u0627\u0634\u0631",
                "value": "\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646\u0634\u0648\u0631 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0642\u0627\u0641 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0628\u062f\u0648\u0646 \u0628\u064a\u0627\u0646\u0627\u062a"
            },
            {
                "label": "\u0639\u062f\u062f \u0635\u0641\u062d\u0627\u062a (\u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0648\u0631\u0642\u064a)",
                "value": "21"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \"\u0648\u0638\u064a\u0641\u0629 \u0627\u0644\u0642\u0636\u0627\u0621 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0625\u0631\u0647\u0627\u0628\" \u0644\u0644\u0645\u0624\u0644\u0641 \u062f. \u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u062d\u064a\u0645\u064a\u062f\u060c \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u062f\u0648\u0631 \u0627\u0644\u0642\u0636\u0627\u0621 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0625\u0631\u0647\u0627\u0628 \u0645\u0646 \u0645\u0646\u0638\u0648\u0631 \u0634\u0631\u0639\u064a. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u064f\u0639\u062f \u0628\u062d\u062b\u064b\u0627 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0634\u0631\u0639\u064a\u0629 \u0648\u0627\u0644\u0642\u0636\u0627\u0621\u060c \u062d\u064a\u062b \u064a\u0633\u0644\u0637 \u0627\u0644\u0636\u0648\u0621 \u0639\u0644\u0649 \u062f\u0648\u0631 \u0627\u0644\u0642\u0636\u0627\u0621 \u0641\u064a \u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u0639\u062f\u0644 \u0648\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0623\u0645\u0646 \u0627\u0644\u0642\u0648\u0645\u064a. \u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0643\u062a\u0627\u0628 \u0639\u0644\u0649 \u0645\u0628\u0627\u062d\u062b \u0645\u062a\u0639\u0645\u0642\u0629 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0642\u0636\u0627\u0621 \u0648\u0627\u0644\u0625\u0631\u0647\u0627\u0628\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u062f\u0644\u0627\u0626\u0644 \u0627\u0644\u0642\u0636\u0627\u0626\u064a\u0629 \u0644\u062a\u062c\u0631\u064a\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0625\u0631\u0647\u0627\u0628\u064a\u0629\u060c \u0648\u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0642\u0636\u0627\u0626\u064a\u0629 \u0644\u0644\u0648\u0642\u0627\u0626\u0639 \u0627\u0644\u0625\u0631\u0647\u0627\u0628\u064a\u0629\u060c \u0648\u064a\u0634\u0645\u0644 \u0623\u064a\u0636\u064b\u0627 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u062d\u0642\u064a\u0642 \u0641\u064a \u0627\u0644\u062c\u0631\u0627\u0626\u0645 \u0627\u0644\u0625\u0631\u0647\u0627\u0628\u064a\u0629. \u064a\u0639\u062f \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0635\u062f\u0631\u064b\u0627 \u0645\u0641\u064a\u062f\u064b\u0627 \u0644\u0644\u0628\u0627\u062d\u062b\u064a\u0646 \u0648\u0627\u0644\u0645\u062e\u062a\u0635\u064a\u0646 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0634\u0631\u0639\u064a\u0629 \u0648\u0627\u0644\u0642\u0636\u0627\u0621\u060c \u0648\u0643\u0630\u0644\u0643 \u0644\u0644\u0642\u0636\u0627\u0621 \u0646\u0641\u0633\u0647 \u0641\u064a \u0641\u0647\u0645 \u062f\u0648\u0631\u0647 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0625\u0631\u0647\u0627\u0628."
    }
