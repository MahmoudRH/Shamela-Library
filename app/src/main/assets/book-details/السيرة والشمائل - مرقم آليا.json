        "description": "\u0643\u062a\u0627\u0628 \u00ab\u0631\u062d\u0645\u0629 \u0644\u0644\u0639\u0627\u0644\u0645\u064a\u0646\u00bb \u0644\u0633\u0639\u064a\u062f \u0628\u0646 \u0648\u0647\u0641 \u0627\u0644\u0642\u062d\u0637\u0627\u0646\u064a \u064a\u064f\u0639\u0646\u0649 \u0628\u0633\u064a\u0631\u0629 \u0627\u0644\u0646\u0628\u064a \u0645\u062d\u0645\u062f \ufdfa \u0648\u0633\u0645\u0627\u062a\u0647 \u0627\u0644\u062e\u0644\u0642\u064a\u0629\u060c \u0645\u064f\u0642\u0633\u0651\u064e\u0645 \u0625\u0644\u0649 \u0641\u0635\u0648\u0644 \u062a\u062a\u0646\u0627\u0648\u0644 \u0646\u0633\u0628\u0647 \u0648\u0645\u064a\u0644\u0627\u062f\u0647 \u0648\u0648\u0641\u0627\u062a\u0647\u060c \u0648\u0646\u0634\u0623\u062a\u0647 \u062a\u062d\u062a \u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0644\u0647\u060c \u0648\u062f\u0639\u0648\u062a\u0647 \u0648\u0625\u0639\u062c\u0627\u0632\u0647 \u0645\u0646 \u0627\u0644\u0625\u0633\u0631\u0627\u0621 \u0648\u0627\u0644\u0645\u0639\u0631\u0627\u062c\u060c \u062b\u0645\u0651 \u0635\u0641\u0627\u062a\u0647 \u0627\u0644\u0623\u062e\u0644\u0627\u0642\u064a\u0629 \u0648\u0627\u0644\u0639\u0628\u0627\u062f\u064a\u0629 \u0645\u0646 \u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0635\u0648\u0645 \u0625\u0644\u0649 \u0627\u0644\u0632\u0647\u062f \u0648\u0627\u0644\u0648\u0631\u0639\u060c \u0645\u0639 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u062f\u0631\u0648\u0633 \u0648\u0627\u0644\u0639\u0628\u0631. \u064a\u064e\u0633\u0652\u062a\u064e\u0646\u062f\u064f \u0625\u0644\u0649 \u0627\u0644\u0646\u0635\u0648\u0635 \u0627\u0644\u0642\u0631\u0622\u0646\u064a\u0629 \u0648\u0627\u0644\u062d\u062f\u064a\u062b\u064a\u0629 \u0644\u062a\u0628\u064a\u064a\u0646 \u0643\u064a\u0641 \u0643\u0627\u0646 \u0627\u0644\u0646\u0628\u064a \u0631\u062d\u0645\u0629\u064b \u0644\u0644\u0625\u0646\u0633 \u0648\u0627\u0644\u062c\u0646\u060c \u0648\u0645\u062b\u0644\u0627\u064b \u064a\u064f\u062d\u062a\u0630\u0649 \u0628\u0647 \u0641\u064a \u0627\