                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0623\u0628\u0648 \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u0645\u0646 \u0623\u062d\u0645\u062f \u0628\u0646 \u0634\u0639\u064a\u0628 \u0628\u0646 \u0639\u0644\u064a \u0627\u0644\u062e\u0631\u0627\u0633\u0627\u0646\u064a\u060c \u0627\u0644\u0646\u0633\u0627\u0626\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 303\u0647\u0640)"
            },
            {
                "label": "",
                "value": "\u0647\u0630\u0647 \u0645\u0627\u0626\u0629 \u062d\u062f\u064a\u062b \u0628\u0623\u0633\u0627\u0646\u064a\u062f\u0647\u0627 \u0633\u0627\u0642\u0637\u0629 \u0645\u0646 \u0633\u0646\u0646 \u0627\u0644\u0646\u0633\u0627\u0626\u064a \u0627\u0644\u0643\u0628\u0631\u0649 \u0645\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0637\u0628\u0648\u0639\u0627\u062a (\u0628\u0645\u0627 \u0641\u064a\u0647\u0627 \u0637\u0628\u0639\u0629 \u0627\u0644\u0631\u0633\u0627\u0644\u0629)"
            },
            {
                "label": "",
                "value": "\u0648\u0647\u064a \u0632\u064a\u0627\u062f\u0629 \u0645\u0646 \u0646\u0633\u062e\u0629 \u062d\u0645\u0632\u0629 \u0627\u0644\u0643\u0646\u0627\u0646\u064a \u0645\u0646 \u0627\u0644\u0623\u062d\u0627\u062f\u064a\u062b \u0639\u0644\u0649 \u0633\u0627\u0626\u0631 \u0627\u0644\u0646\u0633\u062e \u0648\u0641\u064a\u0647\u0627 \u062d\u062f\u064a\u062b\u0627\u0646 \u0632\u0627\u0626\u062f\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u062a\u0628\u0649 \u0623\u064a\u0636\u0627 (87\u064888)"
            },
            {
                "label": "* (\u0646\u0633\u062e\u0629 \u062d\u0645\u0632\u0629 \u0627\u0644\u0643\u0646\u0627\u0646\u064a)",
                "value": "\u0646\u0633\u062e\u0629 \u0645\u063a\u0631\u0628\u064a\u0629 \u0639\u062a\u064a\u0642\u0629 \u0644\u0631\u0648\u0627\u064a\u0629 \u062d\u0645\u0632\u0629 \u0631\u0627\u0648\u064a \u0627\u0644\u0633\u0646\u0646 \u0639\u0646 \u0627\u0644\u0646\u0633\u0627\u0626\u064a\u060c \u0648\u0639\u0644\u064a\u0647\u0627 \u0633\u0645\u0627\u0639\u0627\u062a \u0648\u0625\u0633\u0646\u0627\u062f\u0647\u0627 \u0627\u0644\u0649 \u0627\u0644\u0646\u0633\u0627\u0626\u064a \u0648\u0639\u0644\u064a\u0647\u0627 \u0642\u0631\u0627\u0621\u0627\u062a\u060c \u0648\u0647\u0630\u0627 \u0627\u0644\u0633\u0642\u0637 \u064a\u0642\u0639 \u0641\u064a \u0623\u062c\u0632\u0627\u0621 \u0645\u062a\u0641\u0631\u0642\u0629 \u0645\u0646 \u0627\u0644\u0633\u0646\u0646 \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u0648\u0644\u064a\u0633 \u0647\u0648 \u0641\u064a \u0645\u0648\u0636\u0639 \u0648\u0627\u062d\u062f"
            },
            {
                "label": "",
                "value": "\u0628\u0644 \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0645\u0637\u0628\u0648\u0639\u0629 \u0641\u064a\u0647\u0627 \u0646\u0642\u0635 \u062d\u0648\u0627\u0644\u064a \u0645\u0627\u0626\u0629 \u062d\u062f\u064a\u062b \u0641\u064a \u0645\u0648\u0627\u0636\u0639 \u0645\u062a\u0641\u0631\u0642\u0629\u060c \u0645\u062b\u0644\u0627 \u0641\u064a \u0627\u0644\u0637\u0647\u0627\u0631\u0629 \u062e\u0645\u0633\u0629 \u0623\u062d\u0627\u062f\u064a\u062b \u0648\u0641\u064a \u0627\u0644\u0635\u0644\u0627\u0629 \u0639\u0634\u0631\u0629 \u0648\u0647\u0643\u0630\u0627\u060c \u0647\u064a \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0631\u0648\u0627\u064a\u0629 \u062d\u0645\u0632\u0629 \u0627\u0644\u0645\u063a\u0631\u0628\u064a\u0629\u060c \u0648\u062c\u064f\u0645\u0639\u062a \u0647\u0630\u0647 \u0627\u0644\u0623\u062d\u0627\u062f\u064a\u062b \u0645\u0646 \u0645\u0648\u0627\u0636\u0639\u0647\u0627 \u0648\u0623\u064f\u062f\u0631\u062c\u062a \u0647\u0646\u0627\u060c \u0645\u0639 \u0630\u0643\u0631 \u0631\u0642\u0645 \u0627\u0644\u062d\u062f\u064a\u062b \u0648\u0645\u0648\u0637\u0646\u0647"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u060c \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u062d\u0642 \u063a\u064a\u0631 \u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062c\u0645\u0639 \u0645\u0627\u0626\u0629 \u062d\u062f\u064a\u062b \u0628\u0623\u0633\u0627\u0646\u064a\u062f\u0647\u0627 \u0633\u0627\u0642\u0637\u0629 \u0645\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0637\u0628\u0639\u0627\u062a \u0627\u0644\u0645\u062a\u062f\u0627\u0648\u0644\u0629 \u0644\u0633\u0646\u0646 \u0627\u0644\u0646\u0633\u0627\u0626\u064a \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u0648\u0647\u064a \u0623\u062d\u0627\u062f\u064a\u062b \u0648\u0631\u062f\u062a \u0641\u064a \u0646\u0633\u062e\u0629 \u0645\u063a\u0631\u0628\u064a\u0629 \u0639\u062a\u064a\u0642\u0629 \u0628\u0631\u0648\u0627\u064a\u0629 \u062d\u0645\u0632\u0629 \u0627\u0644\u0643\u0646\u0627\u0646\u064a \u0639\u0646 \u0627\u0644\u0646\u0633\u0627\u0626\u064a\u060c \u0648\u062a\u062a\u0648\u0632\u0639 \u0641\u064a \u0645\u0648\u0627\u0636\u0639 \u0645\u062a\u0641\u0631\u0642\u0629 \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0643\u0627\u0644\u0637\u0647\u0627\u0631\u0629 \u0648\u0627\u0644\u0635\u0644\u0627\u0629. \u064a\u0647\u062f\u0641 \u0627\u0644\u0639\u0645\u0644 \u0625\u0644\u0649 \u0625\u062b\u0628\u0627\u062a \u0647\u0630\u0647 \u0627\u0644\u0632\u064a\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u0645 \u062a\u062b\u0628\u062a \u0641\u064a \u0627\u0644\u0645\u0637\u0628\u0648\u0639\u0627\u062a \u0645\u0639 \u0630\u0643\u0631 \u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0623\u062d\u0627\u062f\u064a\u062b \u0648\u0645\u0648\u0627\u0636\u0639\u0647\u0627 \u0627\u0644\u0623\u0635\u0644\u064a\u0629."
    },
    {
