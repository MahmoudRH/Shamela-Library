        "description": "\u0643\u062a\u0627\u0628 \u0641\u064a \u0623\u0635\u0648\u0644 \u0627\u0644\u0641\u0642\u0647 \u064a\u0628\u062d\u062b \u0641\u064a \u0645\u0641\u0647\u0648\u0645 \u0645\u0642\u0627\u0635\u062f \u0627\u0644\u0634\u0631\u064a\u0639\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0648\u0623\u0647\u062f\u0627\u0641\u0647\u0627 \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0627\u0644\u062e\u0627\u0635\u0629\u060c \u0648\u064a\u0648\u0636\u062d \u0645\u0631\u0627\u062a\u0628 \u0627\u0644\u0645\u0635\u0627\u0644\u062d \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0645\u0646 \u0636\u0631\u0648\u0631\u064a\u0627\u062a \u0648\u062d\u0627\u062c\u064a\u0627\u062a \u0648\u062a\u062d\u0633\u064a\u0646\u064a\u0627\u062a\u060c \u0645\u0639 \u062a\u0641\u0635\u064a\u0644 \u0644\u0644\u0643\u0644\u064a\u0627\u062a \u0627\u0644\u062e\u0645\u0633 \u0627\u0644\u062a\u064a \u062a\u0634\u0645\u0644 \u062d\u0641\u0638 \u0627\u0644\u062f\u064a\u0646 \u0648\u0627\u0644\u0646\u0641\u0633 \u0648\u0627\u0644\u0639\u0642\u0644 \u0648\u0627\u0644\u0646\u0633\u0644 \u0648\u0627\u0644\u0645\u0627\u0644\u060c \u0648\u0630\u0644\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u0631\u0636 \u0645\u0646\u0647\u062c\u064a \u0644\u0645\u0628\u0627\u062f\u0626 \u0647\u0630\u0627 \u0627\u0644\u0639\u0644\u0645.",
