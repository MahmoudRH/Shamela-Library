        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0641\u0642\u0647 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0648\u062e\u0635\u0627\u0626\u0635\u0647 \u0648\u0645\u0635\u0627\u062f\u0631\u0647 \u0628\u0634\u0643\u0644 \u0645\u062a\u0643\u0627\u0645\u0644\u060c \u062d\u064a\u062b \u064a\u0628\u062f\u0623 \u0628\u062a\u0642\u062f\u064a\u0645 \u062a\u0639\u0631\u064a\u0641 \u0645\u0641\u0635\u0644 \u0644\u0644\u0641\u0642\u0647 \u0648\u064a\u0646\u0627\u0642\u0634 \u0623\u0635\u0648\u0644\u0647 \u0648\u0623\u0647\u0645\u064a\u062a\u0647 \u0641\u064a \u0627\u0644\u0634\u0631\u064a\u0639\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629. \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u062a\u0648\u0636\u064a\u062d \u0645\u0641\u0647\u0648\u0645 \u0627\u0644\u0641\u0642\u0647 \u0648\u062a\u0645\u064a\u064a\u0632\u0647 \u0639\u0646 \u0627\u0644\u0639\u0642\u0627\u0626\u062f \u0648\u0627\u0644\u0623\u062e\u0644\u0627\u0642\u060c \u0648\u064a\u0634\u0631\u062d \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0641\u0642\u0647\u064a\u0629 \u0648\u062a\u0635\u0646\u064a\u0641\u0647\u0627 \u0625\u0644\u0649 \u062a\u0643\u0644\u064a\u0641\u064a \u0648\u0648\u0636\u0639\u064a. \u0643\u0645\u0627 \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0641\u0642\u0647 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0643\u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0627\u0644\u0633\u0646\u0629 \u0648\u0627\u0644\u0625\u062c\u0645\u0627\u0639 \u0648\u0627\u0644\u0642\u064a\u0627\u0633\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u0623\u0647\u0645 \u0627\u0644\u062e\u0635\u0627\u0626\u0635 \u0627\u0644\u062a\u064a \u062a\u0645\u064a\u0632 \u0627\u0644\u0641\u0642\u0647 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0639\u0646 \u063a\u064a\u0631\u0