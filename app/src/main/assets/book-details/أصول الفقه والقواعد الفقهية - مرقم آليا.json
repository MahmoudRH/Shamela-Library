            }
        ],
        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0642\u064a\u0627\u0633 \u0641\u064a \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0641\u0642\u0647\u064a\u0629\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u0623\u0647\u0645\u064a\u062a\u0647 \u0643\u062f\u0644\u064a\u0644 \u0641\u0642\u0647\u064a \u0631\u0626\u064a\u0633\u064a\u060c \u0645\u0639 \u0645\u0646\u0627\u0642\u0634\u0629 \u0623\u062f\u0644\u0629 \u0441\u0442\u043e\u0440\u043e\u043d\u064a\u0629 \u0648\u0645\u0624\u064a\u062f\u0629 \u0644\u062d\u062c\u064a\u0629 \u0627\u0644\u0642\u064a\u0627\u0633\u060c \u0648\u0623\u062f\u0644\u0629 \u0645\u0639\u0627\u0631\u0636\u0629 \u0644\u0647. \u064a\u0628\u062f\u0623 \u0627\u0644\u0645\u0624\u0644\u0641 \u0628\u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0642\u064a\u0627\u0633 \u0644\u063a\u0629 \u0648\u0627\u0635\u0637\u0644\u0627\u062d\u0627\u064b\u060c \u0648\u064a\u0646\u0627\u0642\u0634 \u0623\u0646\u0648\u0627\u0639\u0647 \u0648\u0623\u0648\u0644 \u0645\u0646 \u0646\u0642\u0644 \u0639\u0646\u0647 \u0625\u0646\u0643\u0627\u0631\u0647. \u062b\u0645 \u064a\u0639\u0631\u0636 \u0644\u0623\u062f\u0644\u0629 \u0646\u0641\u0627\u0629 \u0627\u0644\u0642\u064a\u0627\u0633 \u0645\u0646 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0627\u0644\u0633\u0646\u0629 \u0648\u0627\u0644\u0645\u0639\u0642\u0648\u0644\u060c \u0648\u064a\u0631\u062f \u0639\u0644\u064a\u0647\u0627\u060c \u0648\u064a\u0633\u062a\u062f\u0644 \u0628\u062f\u0648\u0631\u0647 \u0639\u0644\u0649 \u062d\u062c\u064a\u0629 \u0627\u0644\u0642\u064a\u0627\u0633 \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u0633\u0646\u0629 \u0648\u0627\u0644\u0625\u062c\u0645\u0627\u0639. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u0625\u062b\u0628\u0627\u062a \u0635\u062d\u0629 \u0627\u0644\u0642\u064a\u0627\u0633 \u0648\u0628\u064a\u0627\u0646 \u0623\u0647\u0645\u064a\u062a\u0647 \u0641\u064a \u0627\u0633\u062a\u0646\u0628\u0627\u0637 \u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0641\u0642\u0647\u064a\u0629\u060c \u0645\u0639 \u0627\u0644\u0631\u062f \u0639\u0644\u0649 \u0645\u0646\u0643\u0631\u064a\u0647.",
        "descriptionModel": "mlx-community/Qwen2.5-14B-Instruct-4bit"
    },
    {
