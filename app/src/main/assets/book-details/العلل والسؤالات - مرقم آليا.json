            "\u0627\u0644\u0645\u0628\u062d\u062b \u0627\u0644\u062b\u0627\u0645\u0646: \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u062d\u062f\u064a\u062b \u0628\u0633\u0628\u0628 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631",
