        "description": "\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \"\u0623\u062b\u0631 \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u0648\u0646 \u0648\u0627\u0644\u0623\u0633\u0627\u0646\u064a\u062f \u0641\u064a \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0641\u0642\u0647\u0627\u0621\" \u062a\u0623\u0644\u064a\u0641 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0645\u0627\u0647\u0631 \u064a\u0627\u0633\u064a\u0646 \u0627\u0644\u0641\u062d\u0644\u060c \u064a\u064f\u0639\u062f \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646 \u0623\u0647\u0645 \u0627\u0644\u0645\u0631\u0627\u062c\u0639 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u062d\u062f\u064a\u062b \u0648\u0627\u0644\u0641\u0642\u0647 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a. \u064a\u062a\u0639\u0627\u0645\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0639 \u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641 \u0641\u064a \u0627\u0644\u0645\u062a\u0648\u0646 \u0648\u0627\u0644\u0623\u0633\u0627\u0646\u064a\u062f \u0648\u0622\u062b\u0627\u0631\u0647 \u0641\u064a \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0641\u0642\u0647\u0627\u0621. \u064a\u0628\u062f\u0623 \u0627\u0644\u0643\u062a\u0627\u0628 \u0628\u0641\u0635\u0644\u0627\u064b \u062a\u0645\u0647\u064a\u062f\u064a\u0627\u064b \u0644\u0628\u064a\u0627\u0646 \u0645\u0627\u0647\u064a\u0629 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641\u060c \u062b\u0645 \u064a\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0641\u0635\u0648\u0644 \u0645\u062a\u0639\u062f\u062f\u0629 \u062a\u0646\u0627\u0648\u0644\u062a \u0645\u062e\u062a\u0644\u0641 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641\u060c \u0645\u0646 \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0633\u0646\u062f \u0625\u0644\u0649 \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u0646\u060c \u0648\u0634\u0631\u062d \u0623\u0633\u0628\u0627\u0628 \u0647\u0630\u0627 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641 \u0648\u0622\u062b\u0627\u0631\u0647 \u0641\u064a \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0641\u0642\u0647\u0627\u0621. \u064a\u064f\u0639\u062f \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0635\u062f\u0631\u064b\u0627 \u0645\u0647\u0645\u064b\u0627 \u0644\u0644\u0641\u0642\u0647\u0627\u0621 \u0648\u0627\u0644\u0645\u062d\u0642\u0642\u064a\u0646 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u062d\u062f\u064a\u062b \u0648\u0627\u0644\u0641\u0642\u0647 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a.",
        "topics": [
            "\u0627\u0644\u0645\u0642\u062f\u0645\u0629",
            "\u0641\u0635\u0644 \u062a\u0645\u0647\u064a\u062f\u064a \u0644\u0628\u064a\u0627\u0646 \u0645\u0627\u0647\u064a\u0629 \u0627\u0644\u0625\u062e\u062a\u0644\u0627\u0641",
            "\u0627\u0644\u0645\u0628\u062d\u062b \u0627\u0644\u0623\u0648\u0644: \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641 \u0644\u063a\u0629 \u0648\u0627\u0635\u0637\u0644\u0627\u062d\u0627",
            "\u0627\u0644\u0645\u0637\u0644\u0628 \u0627\u0644\u0623\u0648\u0644: \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641 \u0644\u063a\u0629",
            "\u0627\u0644\u0645\u0637\u0644\u0628 \u0627\u0644\u062b\u0627\u0646\u064a: \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0635\u0637\u0644\u0627\u062d\u0627",
