            "\u0627\u0644\u0645\u0628\u062d\u062b \u0627\u0644\u0623\u0648\u0644: \u0631\u0648\u0627\u064a\u0629 \u0627\u0644\u062d\u062f\u064a\u062b \u0628\u0627\u0644\u0645\u0639\u0646\u0649",
            "\u0627\u0644\u0645\u0628\u062d\u062b \u0627\u0644\u062b\u0627\u0646\u064a: \u0645\u062e\u0627\u0644\u0641\u0629 \u0627\u0644\u062d\u062f\u064a\u062b \u0644\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645",
