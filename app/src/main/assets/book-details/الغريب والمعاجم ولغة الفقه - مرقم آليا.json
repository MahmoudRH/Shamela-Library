        "description": "\u0647\u0630\u0627 \u0643\u062a\u0627\u0628 \"\u062e\u0644\u0642 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\" \u0644\u0644\u0645\u0624\u0644\u0641 \u0627\u0644\u0623\u0635\u0645\u0639\u064a\u060c \u064a\u064f\u0635\u0646\u0641 \u0636\u0645\u0646 \u0627\u0644\u063a\u0631\u064a\u0628 \u0648\u0627\u0644\u0645\u0639\u0627\u062c\u0645 \u0648\u0644\u063a\u0629 \u0627\u0644\u0641\u0642\u0647. \u064a\u064f\u0639\u062f \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u062a\u0631\u0627\u062b \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a. \u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0643\u062a\u0627\u0628 \u0639\u0644\u0649 \u0641\u0647\u0631\u0633 \u0645\u062d\u062a\u0648\u064a\u0627\u062a \u064a\u064f\u0638\u0647\u0631 \u062a\u0646\u0648\u0639 \u0627\u0644\u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u062a\u064a \u062a\u0646\u0627\u0648\u0644\u0647\u0627 \u0627\u0644\u0645\u0624\u0644\u0641\u060c \u0645\u0646 \u062d\u0645\u0644 \u0627\u0644\u0645\u0631\u0623\u0629 \u0648\u0648\u0644\u0627\u062f\u062a\u0647\u0627 \u0625\u0644\u0649 \u062a\u0642\u0644\u0628 \u0623\u062d\u0648\u0627\u0644 \u0627\u0644\u0625\u0646\u0633\u0627\u0646. \u064a\u0628\u062f\u0623 \u0627\u0644\u0643\u062a\u0627\u0628 \u0628\u0630\u0643\u0631 \u0645\u0639\u0627\u0646\u064a \u0643\u0644\u0645\u0627\u062a \u0645\u062b\u0644 \"\u0648\u062d\u0645\u0649\" \u0648\"\u0645\u062e\u0636\u062a\" \u0648\"\u0631\u062d\u0648\u0645\"\u060c \u062b\u0645 \u064a\u062a\u0646\u0627\u0648\u0644 \u0623\u062c\u0632\u0627\u0621 \u0627\u0644\u062c\u0633\u0645 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064a \u0645\u0646 \u0627\u0644\u0631\u0623\u0633 \u0625\u0644\u0649 \u0627\u0644\u0630\u0643\u0631. \u064a\u064f\u0638\u0647\u0631 \u0627\u0644\u0645\u0624\u0644\u06