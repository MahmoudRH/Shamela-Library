            },
            {
                "label": "\u062a\u0646\u0628\u064a\u0647",
                "value": "\u0647\u0630\u0647 - \u0641\u0642\u0637 - \u0645\u0648\u0627\u062f \u0645\u0646\u062a\u062e\u0628\u0629 \u0645\u0646 \u0627\u0644\u0635\u062d\u0627\u062d \u0644\u0644\u062c\u0648\u0647\u0631\u064a\u060c \u0641\u0647\u0646\u0627\u0643 \u0645\u0648\u0627\u062f \u0628\u0643\u0627\u0645\u0644\u0647\u0627 \u0644\u0645 \u062a\u064f\u0630\u0643\u0631\u060c \u0648\u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a\u0647 \u0627\u062e\u062a\u0635\u0627\u0631\u060c \u062b\u0645 \u0631\u064f\u062a\u0651\u0650\u0628\u062a \u0639\u0644\u0649 \u0623\u0648\u0627\u0626\u0644 \u0623\u0635\u0648\u0644 \u0627\u0644\u0643\u0644\u0645 (\u0643\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0645\u0635\u0628\u0627\u062d \u0627\u0644\u0645\u0646\u064a\u0631)"
            },
            {
                "label": "",
                "value": "\u0648\u0623\u0635\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 (\u0635\u062d\u0627\u062d \u0627\u0644\u062c\u0648\u0647\u0631\u064a) \u0636\u0645\u0646 \u0643\u062a\u0628 \u0627\u0644\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0634\u0627\u0645\u0644\u0629\u060c \u0648\u0625\u0646\u0645\u0627 \u0623\u0648\u0631\u062f\u0646\u0627 \u0647\u0630\u0647 \u0627\u0644\u0646\u0633\u062e\u0629 \u0644\u0623\u0646 \u0628\u0647\u0627 \u0632\u064a\u0627\u062f\u0629 \u062f\u0642\u0629 \u0648\u062a\u0634\u0643\u064a\u0644 \u0639\u0646 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0644\u0623\u0635\u0644 \u0627\u0644\u0643\u062a\u0627\u0628"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u060c \u0627\u0644\u063a\u0627\u0644\u0628 \u0623\u0646 \u0647\u0630\u0647 \u0646\u0633\u062e\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0637\u0628\u0648\u0639\u0629]"
            }
        ],
        "description": "\u0647\u0630\u0627 \u0643\u062a\u0627\u0628 \"\u0645\u0646\u062a\u062e\u0628 \u0645\u0646 \u0635\u062d\u0627\u062d \u0627\u0644\u062c\u0648\u0647\u0631\u064a\" \u0644\u0644\u0645\u0624\u0644\u0641 \u0623\u0628\u0648 \u0646\u0635\u0631 \u0627\u0644\u062c\u0648\u0647\u0631\u064a\u060c \u064a\u064f\u0639\u062f \u0643\u062a\u0627\u0628\u064b\u0627 \u0645\u0646 \u0643\u062a\u0628 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629\u060c \u0648\u064a\u062d\u0645\u0644 \u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u063a\u0631\u064a\u0628 \u0648\u0627\u0644\u0645\u0639\u0627\u062c\u0645 \u0648\u0644\u063a\u0629 \u0627\u0644\u0641\u0642\u0647. \u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0643\u062a\u0627\u0628 \u0639\u0644\u0649 \u0645\u0648\u0627\u062f \u0645\u0646\u062a\u062e\u0628\u0629 \u0645\u0646 \u0627\u0644\u0635\u062d\u0627\u062d \u0644\u0644\u062c\u0648\u0647\u0631\u064a\u060c \u0648\u062a\u0645 \u062a\u0631\u062a\u064a\u0628\u0647\u0627 \u0639\u0644\u0649 \u0623\u0648\u0627\u0626\u0644 \u0627\u0644\u0643\u0644\u0645\u0627\u062a\u060c \u0643\u0645\u0627 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0641\u0647\u0631\u0633 \u0644\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a \u064a\u064f\u0633\u0647\u0644 \u0639\u0644\u0649 \u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u0645\u062a\u0646\u0648\u0639\u0629. \u064a\u064f\u0638\u0647\u0631 \u0627\u0644\u0645\u0642\u062a\u0637\u0641 \u0645\u0646 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u064f\u063a\u0637\u064a \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u0636\u064a\u0639\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0645\u0641\u0631\u062f\u0627\u062a \u0648\u0627\u0644\u062a\u0631\u0627\u0643\u064a\u0628 \u0627\u0644\u0644\u063a\u0648\u064a\u0629\u060c \u0648\u064a\u064f\u0638\u0647\u0631 \u0623\u064a\u0636\u064b\u0627 \u0623\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0648\u0627\u062f \u0645\u062a\u0646\u0648\u0639\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0634\u0639\u0631 \u0648\u0627\u0644\u0642\u0635\u0635 \u0648\u0627\u0644\u062a\u0639\u0631\u064a\u0641\u0627\u062a \u0627\u0644\u0644\u063a\u0648\u064a\u0629.",
