        "title": "\u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0641\u064a \u0646\u0638\u0627\u0626\u0631 \u0627\u0644\u0638\u0627\u0621 \u0648\u0627\u0644\u0636\u0627\u062f",
