        "description": "\u0647\u0630\u0627 \u0643\u062a\u0627\u0628 \"\u0627\u0644\u0645\u0630\u0643\u0631 \u0648\u0627\u0644\u0645\u0624\u0646\u062b\" \u0644\u0644\u0645\u0624\u0644\u0641 \u0627\u0628\u0646 \u0627\u0644\u062a\u0633\u062a\u0631\u064a \u0627\u0644\u0643\u0627\u062a\u0628\u060c \u064a\u064f\u0635\u0646\u0641 \u0636\u0645\u0646 \u0627\u0644\u063a\u0631\u064a\u0628 \u0648\u0627\u0644\u0645\u0639\u0627\u062c\u0645 \u0648\u0644\u063a\u0629 \u0627\u0644\u0641\u0642\u0647. \u064a\u064f\u0642\u062f\u0645 \u0627\u0644\u0643\u062a\u0627\u0628 \u0641\u0647\u0631\u0633\u064b\u0627 \u0644\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a \u064a\u062a\u0636\u0645\u0646 \u0628\u0627\u0628\u064b\u0627 \u0644\u0643\u0644 \u062d\u0631\u0641 \u0645\u0646 \u062d\u0631\u0648\u0641 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u064a\u064f\u063a\u0637\u064a \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0645\u0630\u0643\u0631 \u0648\u0627\u0644\u0645\u0624\u0646\u062b \u0641\u064a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629. \u064a\u0628\u062f\u0623 \u0627\u0644\u0643\u062a\u0627\u0628 \u0628\u0628\u064a\u0627\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0642\u064a\u0627\u0633 \u0645\u0637\u0631\u062f \u0628\u064a\u0646 \u0627\u0644\u0645\u0630\u0643\u0631 \u0648\u0627\u0644\u0645\u0624\u0646\u062b\u060c \u0648\u064a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0648\u062c\u0648\u062f \u0639\u0644\u0627\u0645\u0627\u062a \u062a\u0623\u0646\u062b\u064a\u0629 \u0645\u062b\u0644 \u0627\u0644\u0647\u0627\u0621 \u0648\u0627\u0644\u0623\u0644\u0641 \u0627\u0644\u0645\u0645\u062f\u0648\u062f\u0629 \u0648\u0627\u0644\u0623\u0644\u0641 \u0627\u0644\u0645\u0642\u0635\u0648\u0631\u0629\u060c \u0648\u0627\u0644\u062a\u064a \u062a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0624\u0646\u062b\u0629. \u064a\u064f\u062d\u0644\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u064b\u0627 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062c\u0633\u0645 \u0627\u0644\u0628\u0634\u0631\u064a\u060c \u062d\u064a\u062b \u064a\u064f\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0630\u0643\u0631 \u0648\u0627\u0644\u0645\u0624\u0646\u062b \u0641\u064a \u0645\u062e\u062a\u0644\u0641 \u0623\u062c\u0632\u0627\u0621 \u0627\u0644\u062c\u0633\u0645\u060c \u0648\u064a\u064f\u0642\u062f\u0645 \u0623\u0645\u062b\u0644\u0629 \u0639\u0644\u0649 \u0630\u0644\u0643. \u064a\u064f\u063a\u0637\u064a \u0627\u0644\u0643\u062a\u0627\u0628 \u0623\u064a\u0636\u064b\u0627 \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629\u060c \u0645\u062b\u0644 \u0645\u0627 \u064a\u0624\u0646\u062b \u0645\u0646 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u062a\u064a \u062a\u0648\u062c\u062f \u0633\u0645\u0627\u0639\u064b\u0627\u060c \u0645\u062b\u0644 \u0627\u0644\u0645\u0644\u062d \u0648\u0627\u0644\u0646\u0627\u0631 \u0648\u0627\u0644\u062f\u0644\u0648\u060c \u0648\u063a\u064a\u0631\u0647\u0627. \u064a\u064f\u0639\u062f \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0635\u062f\u0631\u064b\u0627 \u0645\u0641\u064a\u062f\u064b\u0627 \u0644\u0644\u0628\u0627\u062d\u062b\u064a\u0646 \u0641\u064a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0641\u0642\u0647.",
