        ],
        "description": "\u0636\u0639\u064a\u0641 \u0627\u0644\u062a\u0631\u063a\u064a\u0628 \u0648\u0627\u0644\u062a\u0631\u0647\u064a\u0628. \u0643\u062a\u0627\u0628 \u0623\u0644\u0641\u0647 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0645\u062d\u062f\u062b \u0645\u062d\u0645\u062f \u0646\u0627\u0635\u0631 \u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0623\u0644\u0628\u0627\u0646\u064a\u060c \u0642\u0635\u062f \u0628\u0647 \u062a\u0628\u064a\u0646 \u0627\u0644\u0623\u062d\u0627\u062f\u064a\u062b \u0627\u0644\u0636\u0639\u064a\u0641\u0629 \u0627\u0644\u062a\u064a \u0641\u064a \u0643\u062a\u0627\u0628 \u0627\u0644\u062a\u0631\u063a\u064a\u0628 \u0648\u0627\u0644\u062a\u0631\u0647\u064a\u0628 \u0644\u0644\u062d\u0627\u0641\u0638 \u0627\u0644\u0645\u0646\u0630\u0631\u064a . \u0648\u0642\u062f \u062d\u0631\u0635 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0623\u0644\u0628\u0627\u0646\u064a \u0639\u0644\u0649 \u062a\u062e\u0631\u064a\u062c \u0623\u062d\u0627\u062f\u064a\u062b \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0639\u0632\u0648\u0647\u0627 \u0625\u0644\u0649 \u0645\u0635\u0627\u062f\u0631\u0647\u0627. \u0648\u0642\u062f \u0646\u0628\u0647 \u0641\u064a \u0645\u0646\u0647\u062c\u0647 \u0644\u0644\u0643\u062a\u0627\u0628\u060c \u0645\u0627 \u064a\u0624\u062e\u0630 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0630\u0631\u064a -\u0631\u062d\u0645\u0647 \u0627\u0644\u0644\u0647- \u0645\u0646 \u0623\u0645\u0648\u0631 \u0648\u0623\u0648\u0647\u0627\u0645 \u0648\u0642\u0639\u062a \u0644\u0647 \u0641\u064a \u0623\u062d\u0627\u062f\u064a\u062b\u0647. \u0648\u0642\u062f \u062c\u0639\u0644 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0623\u0644\u0628\u0627\u0646\u064a -\u0631\u062d\u0645\u0647 \u0627\u0644\u0644\u0647- \u0645\u0631\u0627\u062a\u0628 \u0623\u062d\u0627\u062f\u064a\u062b \u0627\u0644\u0643\u062a\u0627\u0628 \u062e\u0645\u0633 \u0645\u0631\u0627\u062a\u0628 \u0648\u0647\u064a: \u0636\u0639\u064a\u0641 \u0636\u0639\u064a\u0641 \u062c\u062f\u0627 \u0645\u0648\u0636\u0648\u0639 \u0645\u0646\u0643\u0631 \u0634\u0627\u0630",
        "descriptionSource": "\u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627",
