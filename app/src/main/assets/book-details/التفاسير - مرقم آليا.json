                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639\u060c \u0648\u0647\u0648 \u0636\u0645\u0646 \u062e\u062f\u0645\u0629 \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u062a\u0641\u0627\u0633\u064a\u0631]"
            }
        ],
        "description": "\u0643\u062a\u0627\u0628 \u0627\u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u064a \u0644\u0645\u0627 \u0641\u064a \u0633\u0648\u0631\u0629 \u0627\u0644\u0646\u062d\u0644 \u0645\u0646 \u062f\u0642\u0627\u0626\u0642 \u0627\u0644\u0645\u0639\u0627\u0646\u064a \u0644\u0633\u0627\u0645\u064a \u0627\u0644\u0642\u062f\u0648\u0645\u064a \u0647\u0648 \u062a\u0641\u0633\u064a\u0631 \u0645\u0641\u0635\u0644 \u0644\u0633\u0648\u0631\u0629 \u0627\u0644\u0646\u062d\u0644 \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0645\u0639\u0627\u0646\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0644\u0644\u0622\u064a\u0627\u062a. \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0642\u062f\u0645\u0629 \u0639\u0646 \u0641\u0636\u0644 \u062a\u0639\u0644\u0645 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u062a\u0639\u0644\u064a\u0645\u0647\u060c \u0648\u0639\u0631\u0636\u0627\u064b \u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u062a\u0623\u0644\u064a\u0641 \u0648\u0645\u0646\u0647\u062c\u0647 \u0641\u064a \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u062a\u0641\u0633\u064a\u0631\u060c \u062b\u0645 \u064a\u062a\u0646\u0627\u0648\u0644 \u0634\u0631\u062d \u0627\u0644\u0633\u0648\u0631\u0629 \u0645\u0639 \u062a\u0648\u0636\u064a\u062d \u0645\u0648\u0636\u0648\u0639\u0647\u0627 \u0627\u0644\u0639\u0627\u0645. \u064a\u0646\u062f\u0631\u062c \u0647\u0630\u0627 \u0627\u0644\u0639\u0645\u0644 \u0636\u0645\u0646 \u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u062a\u0641\u0627\u0633\u064a\u0631 \u0627\u0644\u0645\u0631\u0642\u0645\u0629 \u0622\u0644\u064a\u0627\u064b."
