            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639\u060c \u0648\u0647\u0648 \u0636\u0645\u0646 \u062e\u062f\u0645\u0629 \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u062a\u0641\u0627\u0633\u064a\u0631]"
            }
        ],
        "description": "\u0623\u064a\u0633\u0631 \u0627\u0644\u062a\u0641\u0627\u0633\u064a\u0631 \u0644\u0623\u0633\u0639\u062f \u062d\u0648\u0645\u062f \u0647\u0648 \u062a\u0641\u0633\u064a\u0631 \u0645\u064a\u0633\u0631 \u0644\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645\u060c \u064a\u062a\u0646\u0627\u0648\u0644 \u0622\u064a\u0627\u062a\u0647 \u0628\u0634\u0643\u0644 \u0645\u062e\u062a\u0635\u0631 \u0648\u0645\u0628\u0633\u0651\u0637\u060c \u0645\u0639\u062a\u0645\u062f\u064b\u0627 \u0639\u0644\u0649 \u0641\u0647\u0645\u0647 \u0627\u0644\u062e\u0627\u0635 \u0644\u0644\u0646\u0635 \u0627\u0644\u0642\u0631\u0622\u0646\u064a. \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u062a\u0648\u0636\u064a\u062d \u0627\u0644\u0645\u0639\u0627\u0646\u064a \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0622\u064a\u0627\u062a \u0648\u0627\u0644\u0623\u062d\u0627\u062f\u064a\u062b \u0627\u0644\u0646\u0628\u0648\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u062a\u0628\u0637 \u0628\u0647\u0627\u060c \u0645\u0639 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0628\u0639\u0636 \u0627\u0644\u0622\u0631\u0627\u0621 \u0627\u0644\u0641\u0642\u0647\u064a\u0629 \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0645\u0636\u0627\u0645\u064a\u0646 \u0627\u0644\u062f\u064a\u0646\u064a\u0629. \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u064b\u060c \u0645\u0645\u0627 \u064a\u0633\u0647\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062c\u0627\u0639 \u0648\u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u062a\u0623\u0646\u064a\u0629 \u0644\u0643\u0644 \u0633\u0648\u0631\u0629 \u0639\u0644\u0649 \u062d\u062f\u0629."
    },
    {
        "title": "\u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0639\u0644\u0649 \u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0642\u0631\u0637\u0628\u064a",
        "authorDeathYear": null,
        "about": [
            {
                "label": "\u0645\u0624\u0644\u0641 \u0627\u0644\u0623\u0635\u0644",
                "value": "\u0623\u0628\u0648 \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0645\u062d\u0645\u062f \u0628\u0646 \u0623\u062d\u0645\u062f\u060c \u0634\u0645\u0633 \u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0642\u0631\u0637\u0628\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 671\u0647\u0640)"
