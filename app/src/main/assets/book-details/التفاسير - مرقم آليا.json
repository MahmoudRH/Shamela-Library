            {
                "label": "\u0627\u0644\u0634\u0627\u0631\u062d",
                "value": "\u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u0645\u0646 \u0628\u0646 \u062d\u0645\u062f \u0627\u0644\u062e\u0636\u064a\u0631"
            },
            {
                "label": "",
                "value": "\u062f\u0631\u0648\u0633 \u0645\u0641\u0631\u063a\u0629 \u0645\u0646 \u0645\u0648\u0642\u0639 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u062e\u0636\u064a\u0631"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u060c \u0631\u0642\u0645 \u0627\u0644\u062c\u0632\u0621 \u0647\u0648 \u0631\u0642\u0645 \u0627\u0644\u062f\u0631\u0633 - 22 \u062f\u0631\u0633\u0627]"
            }
        ],
        "description": "\u064a\u0642\u062f\u0645 \u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u0627\u0644\u062e\u0636\u064a\u0631 \u0641\u064a \u0643\u062a\u0627\u0628\u0647 \"\u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0639\u0644\u0649 \u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0642\u0631\u0637\u0628\u064a\" \u062a\u0641\u0633\u064a\u0631\u064b\u0627 \u0645\u0641\u0635\u0644\u064b\u0627 \u0644\u0628\u0639\u0636 \u0627\u0644\u0622\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0622\u0646\u064a\u0629 \u0645\u0646 \u0633\u0648\u0631 \u0627\u0644\u062d\u062c \u0648\u0627\u0644\u0646\u062c\u0648\u0645 \u0648\u0627\u0644\u0641\u0631\u0642\u0627\u0646 \u0648\u0627\u0644\u0634\u0639\u0631\u0627\u0621 \u0648\u0627\u0644\u0642\u0635\u0635\u060c \u0645\u0639\u062a\u0645\u062f\u064b\u0627 \u0639\u0644\u0649 \u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0625\u0645\u0627\u0645 \u0627\u0644\u0642\u0631\u0637\u0628\u064a \u0627\u0644\u0623\u0635\u0644\u064a. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u062e\u0636\u064a\u0631 \u0645\u0648\u0627\u0636\u064a\u0639 \u0645\u062a\u0639\u062f\u062f\u0629 \u0645\u0646 \u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0634\u0631\u0639\u064a\u0629 \u0648\u0627\u0644\u0642\u0635\u0635 \u0627\u0644\u0642\u0631\u0622\u0646\u064a\u060c \u0645\u0639 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0622\u0631\u0627\u0621 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0641\u064a \u0645\u0633\u0627\u0626\u0644 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u062a\u0641\u0633\u064a\u0631 \u0622\u064a\u0627\u062a \u062a\u062a\u0639\u0644\u0642 \u0628\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0632\u0648\u0627\u062c \u0648\u0627\u0644\u0642\u0630\u0641 \u0648\u0642\u0635\u0629 \u0627\u0644\u0625\u0641\u0643 \u0648\u063a\u064a\u0631\u0647\u0627. \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u064b \u0648\u064a\u062a\u0623\u0644\u0641 \u0645\u0646 \u062f\u0631\u0648\u0633 \u0645\u0641\u0631\u063a\u0629 \u0645\u0646 \u062f\u0631\u0648\u0633 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u062e\u0636\u064a\u0631."
    },
    {
        "title": "\u0627\u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u064a \u0644\u0645\u0627 \u0641\u064a \u0633\u0648\u0631\u0629 \u0627\u0644\u0646\u062d\u0644 \u0645\u0646 \u062f\u0642\u0627\u0626\u0642 \u0627\u0644\u0645\u0639\u0627\u0646\u064a",
