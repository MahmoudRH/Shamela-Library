        "description": "\u0643\u062a\u0627\u0628 \u00ab\u0627\u0644\u0623\u064a\u0648\u0628\u064a\u0648\u0646 \u0628\u0639\u062f \u0635\u0644\u0627\u062d \u0627\u0644\u062f\u064a\u0646\u00bb \u0644\u0644\u0643\u0627\u062a\u0628 \u0639\u0644\u064a \u0645\u062d\u0645\u062f \u0627\u0644\u0635\u0644\u0627\u0628\u064a \u064a\u064f\u0639\u0646\u0649 \u0628\u062f\u0631\u0627\u0633\u0629 \u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0623\u064a\u0648\u0628\u064a\u0629 \u0639\u0642\u0628 \u0648\u0641\u0627\u0629 \u0635\u0644\u0627\u062d \u0627\u0644\u062f\u064a\u0646\u060c \u0645\u0631\u0643\u0651\u0632\u0627\u064b \u0639\u0644\u0649 \u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0623\u0642\u0627\u0644\u064a\u0645\u060c \u0627\u0644\u0646\u0632\u0627\u0639\u0627\u062a \u0628\u064a\u0646 \u062e\u0644\u0641\u0627\u0626\u0647\u060c \u0648\u062a\u062d\u0648\u0644\u0627\u062a \u0627\u0644\u0633\u0644\u0637\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0639\u0627\u062f\u0644\u060c \u0627\u0644\u0623\u0641\u0636\u0644\u060c \u0648\u0627\u0644\u0639\u0632\u064a\u0632. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0645\u0624\u0644\u0641 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062a\u062d\u0627\u0644\u0641\u0627\u062a\u060c \u0627\u0644\u0627\u0646\u062a\u0635\u0627\u0631\u0627\u062a\u060c \u0648\u0627\u0644\u0648\u0641\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u064a \u0623\u062b\u0631\u062a \u0639\u0644\u0649 \u0645\u0633\u0627\u0631 \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0623\u064a\u0648\u0628\u064a\u0629\u060c \u0645\u0633\u062a\u0646\u062f\u0627\u064b \u0625\u0644\u0649 \u0641\u0647\u0631\u0633 \u0634\u0627\u0645\u0644 \u064a\u0636\u0645 \u0645\u0628\u0627\u062d\u062b \u0639\u0646 \u0627\u0644\u0642\u0636\u0627\u0629 \u0627\u0644\u0641\u0627\u0636\u0644\u064a\u0646\u060c \u0627\u0644\u062d\u0631\u0648\u0628 \u0645\u0639 \u0627\u0644\u0641\u0631\u0646\u062c\u0629\u060c \u0648\u0645\u0646\u0627\u0632\u0644 \u0627\u0644\u0623\u064a\u0648\u0628\u064a\u064a\u0646. \u064a\u064f\u0635\u0646\u0651\u0641 \u0627\u0644\u0643\u062a\u0627\u0628 \u0636\u0645\u0646 \u0623\u062f\u0628 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u060c \u0648\u064a\u064f\u0639\u062f\u0651 \u062d\u0644\u0642\u0629\u064b \u0645\u0647\u0645\u0629 \u0641\u064a \u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u062d\u0631\u0648\u0628 \u0627\u0644\u0635\u0644\u064a\u0628\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u064f\u0633\u062a\u0639\u0631\u0636 \u0641\u064a\u0647\u0627 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0627\u0644\u0633\u064a\u0627\u0633\u064a\u0629 \u0648\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0644\u062a\u0644\u0643 \u0627\u0644\u0641\u062a\u0631\u0629."
    },
    {
        "title": "\u0627\u0644\u062d\u0648\u0627\u062f\u062b \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0646\u0627\u0641\u0639\u0629 \u0641\u064a \u0627\u0644\u0645\u0627\u0626\u0629 \u0627\u0644\u0633\u0627\u0628\u0639\u0629",
        "authorDeathYear": 723,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0643\u0645\u0627\u0644 \u0627\u0644\u062f\u064a\u0646 \u0623\u0628\u0648 \u0627\u0644\u0641\u0636\u0644 \u0639\u0628\u062f \u0627\u0644\u0631\u0632\u0627\u0642 \u0628\u0646 \u0623\u062d\u0645\u062f \u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0644\u0635\u0627\u0628\u0648\u0646\u064a \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0628\u0627\u0628\u0646 \u0627\u0644\u0641\u0648\u0637\u064a (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 723\u0647\u0640)"
