            }
        ],
        "description": "\u064a\u064f\u0639\u062f \u0643\u062a\u0627\u0628 \"\u0639\u0642\u062f \u0627\u0644\u062c\u0645\u0627\u0646 \u0641\u064a \u062a\u0627\u0631\u064a\u062e \u0623\u0647\u0644 \u0627\u0644\u0632\u0645\u0627\u0646\" \u0644\u0628\u062f\u0631 \u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0639\u064a\u0646\u064a \u0645\u0624\u0644\u0641\u064b\u0627 \u062a\u0627\u0631\u064a\u062e\u064a\u064b\u0627 \u064a\u0633\u062c\u0644 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0648\u0627\u0644\u0648\u0642\u0627\u0626\u0639 \u0627\u0644\u062a\u064a \u062c\u0631\u062a \u0641\u064a \u0641\u062a\u0631\u0629 \u0632\u0645\u0646\u064a\u0629 \u0645\u062d\u062f\u062f\u0629. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u062a\u0641\u0627\u0635\u064a\u0644 \u0645\u0647\u0645\u0629 \u062a\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u062f\u0648\u0644 \u0648\u0627\u0644\u0633\u0644\u0637\u0646\u0627\u062a\u060c \u0645\u062b\u0644 \u0633\u0644\u0637\u0646\u0629 \u0634\u062c\u0631 \u0627\u0644\u062f\u0631\u060c \u0648\u0633\u0644\u0637\u0646\u0629 \u0623\u064a\u0628\u0643 \u0627\u0644\u062a\u0631\u0643\u0645\u0627\u0646\u064a\u060c \u0648\u0633\u0644\u0637\u0646\u0629 \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0623\u0634\u0631\u0641 \u0645\u0638\u0641\u0631 \u0627\u0644\u062f\u064a\u0646 \u0645\u0648\u0633\u0649\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0643\u0631 \u0648\u0641\u064a\u0627\u062a \u0627\u0644\u0623\u0639\u064a\u0627\u0646. \u0643\u0645\u0627 \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0633\u0631\u062f\u064b\u0627 \u0644\u0645\u0639\u0627\u0631\u0643 \u0648\u062d\u0648\u0627\u062f\u062b \u0628\u0627\u0631\u0632\u0629\u060c \u0643\u0643\u0633\u0631 \u0627\u0644\u0641\u0631\u0646\u062c \u0648\u0623\u0633\u0631 \u0631\u064a\u062f \u0627\u0641\u0631\u0646\u0633\u060c \u0648\u0645\u0627 \u062c\u0631\u0649 \u0645\u0646 \u0627\u0644\u0623\u0645\u0648\u0631 \u0628\u0639\u062f \u0630\u0644\u0643."
    },
    {
        "title": "\u0645\u062e\u062a\u0635\u0631 \u0633\u0646\u0627 \u0627\u0644\u0628\u0631\u0642 \u0627\u0644\u0634\u0627\u0645\u064a",
        "authorDeathYear": 643,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0627\u0644\u0641\u062a\u062d \u0628\u0646 \u0639\u0644\u064a \u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0644\u0628\u0646\u062f\u0627\u0631\u064a \u0627\u0644\u0623\u0635\u0641\u0647\u0627\u0646\u064a\u060c \u0623\u0628\u0648 \u0625\u0628\u0631\u0627\u0647\u064a\u0645 (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 643\u0647\u0640)"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0645\u062e\u062a\u0635\u0631 \u0633\u0646\u0627 \u0627\u0644\u0628\u0631\u0642 \u0627\u0644\u0634\u0627\u0645\u064a \u0647\u0648 \u0639\u0645\u0644 \u062a\u0627\u0631\u064a\u062e\u064a \u064a\u062a\u0646\u0627\u0648\u0644 \u0633\u064a\u0631\u0629 \u062f\u0648\u0644\u0629 \u0646\u0648\u0631 \u0627\u0644\u062f\u064a\u0646 \u0632\u0646\u0643\u064a \u0648\u0623\u062d\u062f\u0627\u062b\u064b\u0627 \u0645\u0647\u0645\u0629 \u0641\u064a \u0627\u0644\u0634\u0627\u0645 \u0648\u0645\u0635\u0631. \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0641\u0635\u0648\u0644\u064b\u0627 \u0639\u0646 \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0624\u0644\u0641 \u0625\u0644\u0649 \u0627\u0644\u0634\u0627\u0645\u060c \u0648\u062f\u062e\u0648\u0644\u0647 \u0641\u064a \u062e\u062f\u0645\u0629 \u0646\u0648\u0631 \u0627\u0644\u062f\u064a\u0646\u060c \u0648\u0623\u062d\u062f\u0627\u062b\u064b\u0627 \u062a\u062a\u0639\u0644\u0642 \u0628\u0623\u0633\u062f \u0627\u0644\u062f\u064a\u0646 \u0648\u062a\u0648\u0631\u0646\u0634\u0627\u0647\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0643\u0631 \u0648\u0641\u0627\u0629 \u0646\u0648\u0631 \u0627\u0644\u062f\u064a\u0646 \u0645\u062d\u0645\u0648\u062f. \u0643\u0645\u0627 \u064a\u062a\u0637\u0631\u0642 \u0625\u0644\u0649 \u0641\u062a\u062d \u0642\u0644\u0639\u0629 \u062c\u0639\u0628\u0631 \u0648\u0645\u0633\u064a\u0631 \u0627\u0644\u0641\u0631\u0646\u062c \u0625\u0644\u0649 \u0645\u0635\u0631 \u0648\u0648\u0641\u0627\u0629 \u0623\u0633\u062f \u0627\u0644\u062f\u064a\u0646."
    },
    {
        "title": "\u0645\u0648\u0642\u0641 \u0627\u0644\u0635\u062d\u0627\u0628\u0629 \u0645\u0646 \u0623\u062d\u062f\u0627\u062b \u0627\u0644\u0639\u0646\u0641 \u0641\u064a \u0639\u0647\u062f \u0627\u0644\u062e\u0644\u0641\u0627\u0621",
        "authorDeathYear": null,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u062f. \u062d\u0635\u0629 \u0628\u0646\u062a \u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u0627\u0644\u0632\u064a\u062f"
            },
            {
                "label": "\u0627\u0644\u0646\u0627\u0634\u0631",
                "value": "\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0646\u0634\u0648\u0631 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0642\u0627\u0641 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0628\u062f\u0648\u0646 \u0628\u064a\u0627\u0646\u0627\u062a"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627]"
            }
        ],
        "description": "\u0643\u062a\u0627\u0628 \u00ab\u0645\u0648\u0642\u0641 \u0627\u0644\u0635\u062d\u0627\u0628\u0629 \u0645\u0646 \u0623\u062d\u062f\u0627\u062b \u0627\u0644\u0639\u0646\u0641 \u0641\u064a \u0639\u0647\u062f \u0627\u0644\u062e\u0644\u0641\u0627\u0621\u00bb \u0644\u0644\u0643\u0627\u062a\u0628\u0629 \u062d\u0635\u0629 \u0628\u0646\u062a \u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u064a\u0646\u062f\u0631\u062c \u0636\u0645\u0646 \u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u064b. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0628\u062d\u062b \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0639\u0646\u0641 \u0648\u062d\u0643\u0645\u0647 \u0648\u0622\u062b\u0627\u0631\u0647\u060c \u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u0645\u0643\u0627\u0646\u0629 \u0627\u0644\u0635\u062d\u0627\u0628\u0629 \u0641\u064a \u0641\u0647\u0645 \u0627\u0644\u062a\u0634\u0631\u064a\u0639 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0645\u0646 \u062e\u0644\u0627\u0644 \u062f\u0631\u0627\u0633\u0629 \u0623\u062d\u062f\u0627\u062b \u0627\u0644\u0639\u0646\u0641 \u0627\u0644\u062a\u064a \u0648\u0642\u0639\u062a \u0641\u064a \u0639\u0647\u062f \u0627\u0644\u062e\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062f\u064a\u0646. \u0648\u064a\u0642\u0633\u0645 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0625\u0644\u0649 \u0641\u0635\u0648\u0644 \u062a\u062a\u0646\u0627\u0648\u0644 \u0645\u0648\u0642\u0641 \u0627\u0644\u0635\u062d\u0627\u0628\u0629 \u0645\u0646 \u0627\u0644\u0639\u0646\u0641 \u0641\u064a \u0639\u0647\u062f\u064a \u0623\u0628\u064a \u0628\u0643\u0631 \u0648\u0639\u0645\u0631 \u0648\u0639\u062b\u0645\u0627\u0646\u060c \u0645\u0639 \u062e\u0627\u062a\u0645\u0629 \u0648\u0645\u0631\u0627\u062c\u0639."
    },
    {
        "title": "\u064a\u0648\u0645\u064a\u0627\u062a \u0634\u0627\u0645\u064a\u0629 = \u0627\u0644\u062d\u0648\u0627\u062f\u062b \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e",
        "authorDeathYear": 1153,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u064a\u0633\u0649 \u0628\u0646 \u0645\u062d\u0645\u0648\u062f \u0628\u0646 \u0643\u0646\u0627\u0646 (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 1153\u0647\u0640)"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u064a\u0642\u062f\u0645 \u0643\u062a\u0627\u0628 \"\u064a\u0648\u0645\u064a\u0627\u062a \u0634\u0627\u0645\u064a\u0629\" \u0644\u0644\u0645\u0624\u0644\u0641 \u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u064a\u0633\u0649 \u0628\u0646 \u0645\u062d\u0645\u0648\u062f \u0628\u0646 \u0643\u0646\u0627\u0646 \u0633\u0644\u0633\u0644\u0629 \u0645\u0646 \u0627\u0644\u064a\u0648\u0645\u064a\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0644\u062d\u0648\u0627\u062f\u062b \u0648\u0623\u062d\u062f\u0627\u062b \u062d\u0635\u0644\u062a \u0641\u064a \u0627\u0644\u0634\u0627\u0645 \u062e\u0644\u0627\u0644 \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062d\u0627\u062f\u064a \u0639\u0634\u0631 \u0627\u0644\u0647\u062c\u0631\u064a. \u064a\u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0648\u0627\u0636\u064a\u0639 \u0645\u062a\u0646\u0648\u0639\u0629 \u062a\u0634\u0645\u0644 \u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0627\u0644\u0633\u064a\u0627\u0633\u064a\u0629 \u0648\u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629\u060c \u0645\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0623\u0647\u0645\u064a\u0629 \u0641\u0646 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0641\u064a \u0646\u0642\u0644 \u0627\u0644\u062e\u0628\u0631\u0627\u062a \u0648\u0627\u0644\u0642\u0635\u0635 \u0639\u0628\u0631 \u0627\u0644\u0623\u062c\u064a\u0627\u0644. \u0643\u0645\u0627 \u064a\u0634\u064a\u0631 \u0627\u0644\u0645\u0624\u0644\u0641 \u0625\u0644\u0649 \u0623\u0647\u0645\u064a\u0629 \u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0641\u064a \u062a\u0639\u0644\u0645 \u062f\u0631\u0648\u0633 \u0627\u0644\u0645\u0627\u0636\u064a \u0648\u0627\u0644\u0627\u0642\u062a\u062f\u0627\u0621 \u0628\u0645\u0627 \u0643\u0627\u0646 \u0639\u0644\u064a\u0647 \u0627\u0644\u0623\u0642\u062f\u0645\u0648\u0646 \u0645\u0646 \u0645\u0643\u0627\u0631\u0645 \u0627\u0644\u0623\u062e\u0644\u0627\u0642."
    }
]