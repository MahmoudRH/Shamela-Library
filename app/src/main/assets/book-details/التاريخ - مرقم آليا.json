            }
        ],
        "description": "\u0627\u0644\u062f\u064a\u0628\u0627\u062c \u0644\u0623\u0628\u064a \u0639\u0628\u064a\u062f\u0629 \u0645\u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u0645\u062b\u0646\u0649 \u0647\u0648 \u0645\u0624\u0644\u0641 \u062a\u0627\u0631\u064a\u062e\u064a \u064a\u0642\u062f\u0651\u0645 \u062a\u0642\u064a\u064a\u0645\u064b\u0627 \u0644\u0644\u0634\u0639\u0631\u0627\u0621 \u0627\u0644\u0639\u0631\u0628 \u0641\u064a \u0627\u0644\u062c\u0627\u0647\u0644\u064a\u0629 \u0648\u0627\u0644\u0625\u0633\u0644\u0627\u0645\u060c \u0645\u0633\u062a\u0646\u062f\u064b\u0627 \u0625\u0644\u0649 \u0622\u0631\u0627\u0621 \u0645\u0639\u0627\u0635\u0631\u064a\u0647\u0645 \u0648\u0645\u0642\u0627\u0631\u0646\u0627\u062a\u0647\u0645 \u0627\u0644\u0623\u062f\u0628\u064a\u0629. \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0628 \u0641\u0635\u0648\u0644\u064b\u0627 \u0645\u062a\u0639\u062f\u062f\u0629 \u062a\u062a\u0646\u0627\u0648\u0644 \u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0634\u0639\u0631\u0627\u0621\u060c \u0648\u0623\u0642\u0633\u0627\u0645\u064b\u0627 \u0639\u0646 \u0642\u0628\u0627\u0626\u0644 \u0627\u0644\u0639\u0631\u0628 \u0648\u0645\u0638\u0627\u0647\u0631\u0647\u0645 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0648\u0627\u0644\u0633\u064a\u0627\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629. \u064a\u0628\u0631\u0632 \u0627\u0644\u0646\u0635 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0646\u0627\u0642\u0634\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0634\u0639\u0631\u0627\u0621 \u0627\u0644\u062c\u0627\u0647\u0644\u064a\u0629 \u0645\u062b\u0644 \u0627\u0645\u0631\u0624 \u0627\u0644\u0642\u064a\u0633 \u0648\u0627\u0644\u0646\u0627\u0628\u063a\u0629 \u0648\u0632\u0647\u064a\u0631\u060c \u0648\u0625\u0633\u0642\u0627\u0637\u0647\u0627 \u0639\u0644\u0649 \u0634\u0639\u0631\u0627\u0621 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0644\u062a\u062d\u062f\u064a\u062f \u0623\u0641\u0636\u0644\u064a\u0627\u062a\u0647\u0645 \u0648\u0645\u0642\u0627\u0631\u0646\u0627\u062a\u0647\u0645."
    },
    {
        "title": "\u0627\u0644\u0646\u0641\u062d\u0629 \u0627\u0644\u0646\u0633\u0631\u064a\u0646\u064a\u0629 \u0648\u0627\u0644\u0644\u0645\u062d\u0629 \u0627\u0644\u0645\u0631\u064a\u0646\u064a\u0629",
        "authorDeathYear": 807,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0625\u0633\u0645\u0627\u0639\u064a\u0644 \u0628\u0646 \u064a\u0648\u0633\u0641 \u0628\u0646 \u0645\u062d\u0645\u062f \u0628\u0646 \u0646\u0635\u0631 \u0627\u0644\u062e\u0632\u0631\u062c\u064a \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064a \u0627\u0644\u0646\u0635\u0631\u064a\u060c \u0623\u0628\u0648 \u0627\u0644\u0648\u0644\u064a\u062f\u060c \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0628\u0627\u0628\u0646 \u0627\u0644\u0623\u062d\u0645\u0631 (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 807\u0647\u0640)"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u0627\u0644\u0643\u062a\u0627\u0628 \"\u0627\u0644\u0646\u0641\u062d\u0629 \u0627\u0644\u0646\u0633\u0631\u064a\u0646\u064a\u0629 \u0648\u0627\u0644\u0644\u0645\u062d\u0629 \u0627\u0644\u0645\u0631\u064a\u0646\u064a\u0629\" \u0645\u0646 \u062a\u0623\u0644\u064a\u0641 \u0627\u0628\u0646 \u0627\u0644\u0623\u062d\u0645\u0631 \u0647\u0648 \u0645\u0624\u0644\u0641 \u062a\u0627\u0631\u064a\u062e\u064a \u064a\u062e\u062a\u0635 \u0628\u0633\u0631\u062f \u0623\u062d\u062f\u0627\u062b \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0645\u0631\u064a\u0646\u064a\u0629\u060c \u0648\u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0623\u0633\u0644\u0648\u0628 \u064a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0623\u0628\u064a\u0627\u062a \u0627\u0644\u0634\u0639\u0631\u064a\u0629 \u0648\u0627\u0644\u0634\u0631\u062d \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a. \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0641\u0647\u0631\u0633 \u062b\u0644\u0627\u062b\u0629 \u0623\u0642\u0633\u0627\u0645 \u0631\u0626\u064a\u0633\u064a\u0629 \u0647\u064a \u0627\u0644\u0628\u0633\u0645\u0644\u0629\u060c \u0627\u0644\u0623\u0628\u064a\u0627\u062a\u060c \u0648\u0627\u0644\u0634\u0631\u062d\u060c \u0645\u0627 \u064a\u062f\u0644 \u0639\u0644\u0649 \u062f\u0645\u062c \u0627\u0644\u0646\u0635\u0648\u0635 \u0627\u0644\u0634\u0639\u0631\u064a\u0629 \u0645\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629. \u062a\u0635\u0646\u064a\u0641\u0647 \u0636\u0645\u0646 \"\u0627\u0644\u062a\u0627\u0631\u064a\u062e - \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\" \u064a\u0648\u0636\u062d \u0623\u0646\u0647 \u0639\u0645\u0644 \u0645\u0631\u062c\u0639\u064a \u064a\u064f\u0639\u0646\u0649 \u0628\u062a\u0648\u062b\u064a\u0642 \u0648\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0648\u0642\u0627\u0626\u0639 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0644\u0644\u062d\u0642\u0628\u0629 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629."
    },
    {
        "title": "\u0627\u0644\u064a\u0648\u0627\u0642\u064a\u062a \u0648\u0627\u0644\u0636\u0631\u0628 \u0641\u064a \u062a\u0627\u0631\u064a\u062e \u062d\u0644\u0628",
        "authorDeathYear": 732,
        "about": [
            {
                "label": "\u0627\u0644\u0645\u0624\u0644\u0641",
                "value": "\u0623\u0628\u0648 \u0627\u0644\u0641\u062f\u0627\u0621 \u0639\u0645\u0627\u062f \u0627\u0644\u062f\u064a\u0646 \u0625\u0633\u0645\u0627\u0639\u064a\u0644 \u0628\u0646 \u0639\u0644\u064a \u0628\u0646 \u0645\u062d\u0645\u0648\u062f \u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0628\u0646 \u0639\u0645\u0631 \u0628\u0646 \u0634\u0627\u0647\u0646\u0634\u0627\u0647 \u0628\u0646 \u0623\u064a\u0648\u0628\u060c \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0645\u0624\u064a\u062f\u060c \u0635\u0627\u062d\u0628 \u062d\u0645\u0627\u0629 (\u0627\u0644\u0645\u062a\u0648\u0641\u0649: 732\u0647\u0640)"
            },
            {
                "label": "",
                "value": "[\u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627 \u063a\u064a\u0631 \u0645\u0648\u0627\u0641\u0642 \u0644\u0644\u0645\u0637\u0628\u0648\u0639]"
            }
        ],
        "description": "\u064a\u0639\u062f \u0643\u062a\u0627\u0628 \"\u0627\u0644\u064a\u0648\u0627\u0642\u064a\u062a \u0648\u0627\u0644\u0636\u0631\u0628 \u0641\u064a \u062a\u0627\u0631\u064a\u062e \u062d\u0644\u0628\" \u0645\u0646 \u062a\u0623\u0644\u064a\u0641 \u0625\u0633\u0645\u0627\u0639\u064a\u0644 \u0623\u0628\u0648 \u0627\u0644\u0641\u062f\u0627\u0621\u060c \u0648\u0647\u0648 \u062a\u0627\u0631\u064a\u062e \u064a\u062a\u0646\u0627\u0648\u0644 \u062a\u0627\u0631\u064a\u062e \u0645\u062f\u064a\u0646\u0629 \u062d\u0644\u0628 \u0648\u062d\u0643\u0627\u0645\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u0639\u0635\u0648\u0631. \u064a\u0631\u0643\u0632 \u0627\u0644\u0643\u062a\u0627\u0628 \u0639\u0644\u0649 \u0630\u0643\u0631 \u0627\u0644\u0645\u0644\u0648\u0643 \u0648\u0627\u0644\u0623\u0645\u0631\u0627\u0621 \u0648\u0627\u0644\u0648\u0644\u0627\u0629 \u0627\u0644\u0630\u064a\u0646 \u062d\u0643\u0645\u0648\u0627 \u062d\u0644\u0628\u060c \u0645\u0639 \u0625\u064a\u0631\u0627\u062f \u0628\u0639\u0636 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0646 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0648\u0627\u0644\u0642\u0636\u0627\u0629. \u064a\u0633\u062a\u0646\u062f \u0627\u0644\u0645\u0624\u0644\u0641 \u0641\u064a \u0645\u0627\u062f\u062a\u0647 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0625\u0644\u0649 \u0643\u062a\u0627\u0628 \"\u0632\u0628\u062f\u0629 \u0627\u0644\u062d\u0644\u0628\" \u0644\u0645\u0648\u0644\u0649 \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0622\u062b\u0631 \u0643\u0645\u0627\u0644 \u0627\u0644\u062f\u064a\u0646 \u0623\u0628\u064a \u062d\u0641\u0635 \u0639\u0645\u0631 \u0628\u0646 \u0623\u062d\u0645\u062f \u0627\u0644\u0639\u0642\u064a\u0644\u064a\u060c \u0648\u064a\u0636\u064a\u0641 \u0625\u0644\u064a\u0647 \u0645\u0627 \u0648\u0635\u0644 \u0625\u0644\u064a\u0647 \u0645\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629. \u0627\u0644\u0643\u062a\u0627\u0628 \u064a\u062a\u0646\u0627\u0648\u0644 \u0623\u064a\u0636\u064b\u0627 \u062a\u0633\u0645\u064a\u0629 \u062d\u0644\u0628 \u0648\u0646\u0634\u0623\u0629 \u062a\u0644 \u0642\u0644\u0639\u062a\u0647\u0627\u060c \u0645\u0633\u062a\u0639\u0631\u0636\u0627\u064b \u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u062d\u0648\u0644 \u0623\u0635\u0644 \u0627\u0644\u0627\u0633\u0645."
    },
    {
        "title": "\u062d\u0644\u0648\u0644 \u0627\u0644\u062a\u0639\u0628 \u0648\u0627\u0644\u0622\u0644\u0627\u0645 \u0628\u0648\u0635\u0648\u0644 \u0623\u0628\u064a \u0627\u0644\u0630\u0647\u0628 \u0625\u0644\u0649 \u062f\u0645\u0634\u0642 \u0627\u0644\u0634\u0627\u0645",
