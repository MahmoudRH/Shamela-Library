            }
        ],
        "description": "\u0643\u062a\u0627\u0628 \u00ab\u0627\u0644\u062d\u0648\u0627\u062f\u062b \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0646\u0627\u0641\u0639\u0629 \u0641\u064a \u0627\u0644\u0645\u0627\u0626\u0629 \u0627\u0644\u0633\u0627\u0628\u0639\u0629\u00bb \u0644\u0644\u0643\u0627\u062a\u0628 \u0627\u0628\u0646 \u0627\u0644\u0641\u0648\u0637\u064a \u064a\u064f\u0635\u0646\u0651\u0641 \u0643\u0639\u0645\u0644 \u062a\u0627\u0631\u064a\u062e\u064a \u0645\u0631\u0642\u0645 \u0622\u0644\u064a\u0627\u064b\u060c \u064a\u0636\u0645\u0651 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0648\u0642\u0627\u0626\u0639 \u0627\u0644\u0645\u062a\u0646\u0648\u0651\u0639\u0629 \u0627\u0644\u062a\u064a \u062c\u0631\u062a \u0641\u064a \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u0633\u0627\u0628\u0639 \u0627\u0644\u0647\u062c\u0631\u064a\u060c \u0645\u0646 \u0639\u0632\u0644 \u0648\u0632\u0631\u0627\u0621 \u0648\u0641\u062a\u0648\u062d \u0645\u062f\u0646 \u0648\u0645\u0624\u0633\u0633\u0627\u062a \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0625\u062f\u0627\u0631\u064a\u0629 \u0648\u062f\u064a\u0646\u064a\u0629. \u064a\u0631\u0643\u0651\u0632 \u0627\u0644\u0646\u0635 \u0639\u0644\u0649 \u0633\u0631\u062f\u064d \u0645\u062a\u0633\u0644\u0633\u0644\u064d \u0644\u0644\u0623\u062d\u062f\u0627\u062b \u0645\u0639 \u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u062a\u0648\u0627\u0631\u064a\u062e\u0647\u0627 \u0648\u0634\u062e\u0635\u064a\u0627\u062a\u0647\u0627\u060c \u0645\u0633\u062a\u0646\u062f\u0627\u064b \u0625\u0644\u0649 \u0645\u0635\u0627\u062f\u0631\u064d \u0645\u0639\u062a\u0645\u062f\u0629 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0639\u0635\u0631."
    },
